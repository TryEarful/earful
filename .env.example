# Copy to .env and adjust as needed. The earful binary itself does not
# auto-load .env files (internal/config reads os.Getenv directly, staying
# strictly 12-factor) -- source this at the shell level if you want it,
# e.g. `export $(cat .env | xargs)`, or pass values via `docker compose`.

APP_ENV=development
PORT=8080
DATABASE_URL=postgres://earful:earful@localhost:5433/earful?sslmode=disable
LOG_LEVEL=info

# Externally-visible origin. Sign-in links in emails are built from this,
# so it must match how you actually reach the app in a browser.
BASE_URL=http://localhost:8080

# Outbound email. "console" prints messages (magic links included) to
# stdout -- in local dev that log is your inbox. "smtp" targets mailpit
# in compose; "brevo" (production) additionally needs BREVO_API_KEY.
EMAIL_SENDER=console

# Google login is optional: set both to enable it, leave unset for
# magic-link-only sign-in. Redirect URI to register with Google:
# ${BASE_URL}/auth/google/callback
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=

# Private beta (M12). BETA_MODE=true gates account creation behind
# one-shot invite codes (mint them with `earful beta-codes add`), makes
# login email+password, and closes every account-creating side door --
# with ZERO emails sent (there is deliberately no ESP yet). Grant the
# admin page with `earful admin grant <email>`.
# BETA_MODE=false
