package templates

import (
	"strconv"

	"github.com/TryEarful/earful/internal/domain"
	"github.com/TryEarful/earful/internal/styleimage"
	"github.com/TryEarful/earful/internal/uitext"
)

// StyleData is the Style tab of one survey (ADR-0018).
type StyleData struct {
	Survey SurveyView
	StyleForm
	Notice string
}

// StyleForm is the form that sets a style: a survey's on its Style tab,
// or an account's on the account's (ADR-0023). Both draw the same
// sections from it.
type StyleForm struct {
	// Style is the style the form edits, or what the creator typed when a
	// save was refused, so that nothing is typed twice.
	Style domain.Style
	// Error is the problem with a refused save, worded with where it is,
	// for the head of the form. ErrorPart and ErrorLink say which field
	// it belongs to, and FieldError words it for beside that field.
	Error      string
	ErrorPart  domain.StylePart
	ErrorLink  int
	FieldError string
	// FilesLost says a file came with a save that was refused. A page
	// cannot put a file back in its field, so it says to choose it again.
	FilesLost bool
	// Account says the form sets the account's style, which every survey
	// follows, rather than one survey's: a few hints say so.
	Account bool
	// Choice is a survey's relation to its account's style: which parts
	// are its own and whether it shows a header and a footer. It is nil
	// on the account's own form.
	Choice *StyleChoiceView
}

// StyleChoiceView says, for a survey's Style tab, which parts of the
// style the survey has made its own and which it follows from its
// account's (ADR-0023).
type StyleChoiceView struct {
	Own      domain.StyleParts
	NoHeader bool
	NoFooter bool
	// HasAccount is whether the account has a style. Without one a
	// survey follows nothing in particular, so the tab says nothing of
	// where a part comes from.
	HasAccount bool
}

// sourceShown reports whether the tab says where each part comes from.
func (d StyleForm) sourceShown() bool { return d.Choice != nil && d.Choice.HasAccount }

// partSource is the message that says where a part of a survey's style
// comes from: its own, or its account's.
func partSource(own bool) uitext.ID {
	if own {
		return "style.source.own"
	}
	return "style.source.account"
}

// AccountStyleData is the account's style page (ADR-0023).
type AccountStyleData struct {
	StyleForm
	Notice string
	// StaleCount is how many open surveys show an earlier version of the
	// account's style, and StaleReady how many of them can be brought up
	// to date now; the rest wait on something the creator has to do.
	StaleCount int
	StaleReady int
}

// AccountStyleApplyData is the question asked after the account's style
// changes: whether to apply it now to the open surveys it reaches.
type AccountStyleApplyData struct {
	Notice string
	// Surveys are the open surveys that show an earlier version of the
	// account's style; Ready is how many of them can take it now.
	Surveys []StaleSurveyView
	Ready   int
	// UpdatedAt names the account's style the question is about, so a
	// style changed since is not applied unseen.
	UpdatedAt string
}

// StaleSurveyView is one survey the question is about.
type StaleSurveyView struct {
	ID    string
	Title string
	// Hold is what keeps the survey from taking the account's style now:
	// "language", "pictures" or "picture_missing", and empty when nothing
	// does.
	Hold string
	// BlockedIn is the language the account's style has to be reviewed
	// in, when Hold is "language", and BlockedName that language as a
	// sentence names it.
	BlockedIn   string
	BlockedName string
	// Limit is how many pictures a survey keeps, when Hold is "pictures".
	Limit int
}

// AccountStyleLanguagesData is the page the account style's words are
// translated on (ADR-0023).
type AccountStyleLanguagesData struct {
	// Source names the account style's words the page shows, so a
	// translation saved from it is checked against the wording its
	// creator read.
	Source string
	Languages []AccountStyleLanguageView
	// HasWords is false while the account's style has nothing written in
	// a language: no tagline, footer text, link or picture description.
	HasWords bool
	// CanTranslate is false when no text AI is configured; translations
	// are then written by hand, as on a survey's Languages tab.
	CanTranslate bool
	Error        string
	Notice       string
}

// AccountStyleLanguageView is the account style's words in one language.
type AccountStyleLanguageView struct {
	Code string
	// Name is the language as a sentence names it, and Label as it stands
	// on its own.
	Name  string
	Label string
	// Carried means a survey is being translated into the language, so it
	// cannot be removed here.
	Carried bool
	Style   LocalizedStyleView
}

// errorTarget is the id of the field the refused save's problem is in,
// for the summary at the head of the form to link to: the field may be a
// screen or more below it. It is empty where the problem has no field.
func (d StyleForm) errorTarget() string {
	if d.FieldError == "" {
		return ""
	}
	switch d.ErrorPart {
	case domain.StyleBanner:
		return styleImageFieldData{Field: "banner"}.id()
	case domain.StyleLogo:
		return styleImageFieldData{Field: "logo"}.id()
	case domain.StyleThanksImage:
		return styleImageFieldData{Field: "thanks_image"}.id()
	case domain.StyleThanksPicture:
		return "style-error-field"
	case domain.StyleHeaderLinks, domain.StyleFooterLinks:
		if d.ErrorLink == 0 {
			return "style-error-field"
		}
	}
	return "style-invalid"
}

// problemIn reports whether the refused save's problem is in part.
func (d StyleForm) problemIn(part domain.StylePart) bool {
	return d.FieldError != "" && d.ErrorPart == part
}

// styleLinkRows is a header's or a footer's links as the form's rows:
// every row the form offers, the saved links first.
func styleLinkRows(links []domain.StyleLink) []domain.StyleLink {
	rows := make([]domain.StyleLink, domain.MaxStyleLinks)
	copy(rows, links)
	return rows
}

// themeName is the message that names a theme.
func themeName(theme string) uitext.ID {
	switch theme {
	case domain.ThemeSlate:
		return "style.theme.slate.name"
	case domain.ThemeOcean:
		return "style.theme.ocean.name"
	case domain.ThemeForest:
		return "style.theme.forest.name"
	}
	return "style.theme.earful.name"
}

// thanksPictureName is the message that names a thanks page's picture.
func thanksPictureName(picture string) uitext.ID {
	switch picture {
	case domain.ThanksCheck:
		return "style.thanks.check"
	case domain.ThanksEnvelope:
		return "style.thanks.envelope"
	case domain.ThanksConfetti:
		return "style.thanks.confetti"
	case domain.ThanksImage:
		return "style.thanks.image"
	case domain.ThanksNone:
		return "style.thanks.none"
	}
	return "style.thanks.owl"
}

// themeHint is the message that says, in a line, what a theme is like.
func themeHint(theme string) uitext.ID {
	switch theme {
	case domain.ThemeSlate:
		return "style.theme.slate.hint"
	case domain.ThemeOcean:
		return "style.theme.ocean.hint"
	case domain.ThemeForest:
		return "style.theme.forest.hint"
	}
	return "style.theme.earful.hint"
}

// SurveyStyle is where a creator sets how a survey looks to the people
// answering it. It is one form with one filled button: everything on it
// is saved to the draft together, like any other draft change, and
// reaches respondents with the next version published. The preview shows
// it before then.
templ SurveyStyle(email string, workspaceName string, csrf string, data StyleData) {
	@Layout(t(ctx, "style.title", uitext.Args{"Survey": data.Survey.Title})) {
		@AuthedHeader(email, csrf)
		<main>
			<nav class="breadcrumb" aria-label={ t(ctx, "breadcrumb.aria") }>
				<a href="/surveys">{ t(ctx, "breadcrumb.surveys") }</a> /
				<a href={ templ.SafeURL("/surveys/" + data.Survey.ID) }>{ data.Survey.Title }</a> /
				{ t(ctx, "style.heading") }
			</nav>
			<div class="title-row">
				<h1>{ t(ctx, "style.heading") }</h1>
				<a class="button secondary js-style-preview" href={ templ.SafeURL("/surveys/" + data.Survey.ID + "/preview") }>{ t(ctx, "editor.preview.label") }</a>
			</div>
			@surveyTabs(data.Survey, "style")
			<p class="muted">{ t(ctx, "style.intro") }</p>
			if data.sourceShown() {
				<p class="muted js-style-account-intro">
					{ t(ctx, "style.account.intro") }
					<a href="/account/style">{ t(ctx, "style.account.link") }</a>
				</p>
			}
			@styleFormSummary(data.StyleForm)
			if data.Notice != "" {
				<p class="notice" role="status">{ data.Notice }</p>
			}
			<form method="post" enctype="multipart/form-data" action={ templ.SafeURL("/surveys/" + data.Survey.ID + "/style") } class="js-style-form">
				<input type="hidden" name="_csrf" value={ csrf }/>
				@styleFormSections(data.StyleForm)
				<div class="button-row">
					<button type="submit">{ t(ctx, "style.save.label") }</button>
					if data.sourceShown() {
						<button type="submit" name="style_action" value="reset" class="secondary js-style-reset">{ t(ctx, "style.reset.label") }</button>
					}
				</div>
				if data.sourceShown() {
					<p class="muted">{ t(ctx, "style.reset.hint") }</p>
				}
			</form>
		</main>
	}
}

// AccountStyle is where a creator sets the account's style: the theme,
// header, footer and thanks picture every survey follows until it makes
// a part its own (ADR-0023). It is the Style tab's form with one filled
// button. A survey takes a change when it is next published, since a
// published version keeps the look it was published with (ADR-0018).
templ AccountStyle(email string, workspaceName string, csrf string, data AccountStyleData) {
	@Layout(t(ctx, "account.style.title")) {
		@AuthedHeader(email, csrf)
		<main>
			<nav class="breadcrumb" aria-label={ t(ctx, "breadcrumb.aria") }>
				<a href="/account">{ t(ctx, "account.heading") }</a> /
				{ t(ctx, "account.style.crumb") }
			</nav>
			<h1>{ t(ctx, "account.style.heading") }</h1>
			<p class="muted">
				{ t(ctx, "account.style.intro") }
				<a class="js-account-style-languages" href="/account/style/languages">{ t(ctx, "account.style.languages.intro_link") }</a>
			</p>
			@styleFormSummary(data.StyleForm)
			if data.Notice != "" {
				<p class="notice" role="status">{ data.Notice }</p>
			}
			if data.StaleCount > 0 {
				<p class="js-account-style-stale">
					{ tn(ctx, "account.style.apply.stale", data.StaleCount) }
					if data.StaleReady > 0 {
						<a href="/account/style/apply">{ tn(ctx, "account.style.apply.stale_link", data.StaleCount) }</a>
					} else {
						<a href="/account/style/apply">{ tn(ctx, "account.style.apply.stale_waiting_link", data.StaleCount) }</a>
					}
				</p>
			}
			<form method="post" enctype="multipart/form-data" action="/account/style" class="js-style-form js-account-style-form">
				<input type="hidden" name="_csrf" value={ csrf }/>
				@styleFormSections(data.StyleForm)
				<button type="submit">{ t(ctx, "account.style.save.label") }</button>
			</form>
		</main>
	}
}

// AccountStyleApply asks whether to apply the account's style now to the
// open surveys that show an earlier version of it (ADR-0023). Each would
// go out again from its live version, its draft untouched; one whose
// languages the account's style is not read in yet is named, with where
// to read it. "Later" leaves each to take it when it is next published.
templ AccountStyleApply(email string, workspaceName string, csrf string, data AccountStyleApplyData) {
	@Layout(t(ctx, "account.style.apply.title")) {
		@AuthedHeader(email, csrf)
		<main>
			<nav class="breadcrumb" aria-label={ t(ctx, "breadcrumb.aria") }>
				<a href="/account">{ t(ctx, "account.heading") }</a> /
				<a href="/account/style">{ t(ctx, "account.style.crumb") }</a> /
				{ t(ctx, "account.style.apply.crumb") }
			</nav>
			<h1>{ t(ctx, "account.style.apply.heading") }</h1>
			if data.Notice != "" {
				<p class="notice" role="status">{ data.Notice }</p>
			}
			<section class="card js-panel js-account-style-apply">
				<p>{ tn(ctx, "account.style.apply.intro", len(data.Surveys)) }</p>
				<ul class="stale-surveys">
					for _, survey := range data.Surveys {
						<li class="js-stale-survey">
							<a href={ templ.SafeURL("/surveys/" + survey.ID) }>{ survey.Title }</a>
							switch survey.Hold {
								case "language":
									<span class="chip js-stale-hold">{ t(ctx, "account.style.apply.chip.language", uitext.Args{"Language": survey.BlockedName}) }</span>
									<span class="muted stale-blocked js-stale-blocked">
										{ t(ctx, "account.style.apply.blocked", uitext.Args{"Language": survey.BlockedName}) }
										<a href={ templ.SafeURL("/account/style/languages#lang-" + survey.BlockedIn) }>{ t(ctx, "account.style.apply.blocked_link") }</a>
									</span>
								case "pictures":
									<span class="chip js-stale-hold">{ t(ctx, "account.style.apply.chip.pictures") }</span>
									<span class="muted stale-blocked js-stale-blocked">
										{ t(ctx, "account.style.apply.pictures", uitext.Args{"Limit": survey.Limit}) }
									</span>
								case "picture_missing":
									<span class="chip js-stale-hold">{ t(ctx, "account.style.apply.chip.picture_missing") }</span>
									<span class="muted stale-blocked js-stale-blocked">
										{ t(ctx, "account.style.apply.picture_missing") }
										<a href="/account/style">{ t(ctx, "account.style.apply.picture_missing_link") }</a>
									</span>
							}
						</li>
					}
				</ul>
				if data.Ready > 0 {
					<p class="muted">{ t(ctx, "account.style.apply.note") }</p>
					<form method="post" action="/account/style/apply" class="js-account-style-apply-form">
						<input type="hidden" name="_csrf" value={ csrf }/>
						<input type="hidden" name="updated_at" value={ data.UpdatedAt }/>
						for _, survey := range data.Surveys {
							if survey.Hold == "" {
								<input type="hidden" name="survey" value={ survey.ID }/>
							}
						}
						<div class="button-row">
							<button type="submit" class="js-account-style-apply-submit">{ tn(ctx, "account.style.apply.submit", data.Ready) }</button>
							<a class="button secondary js-account-style-later" href="/account/style">{ t(ctx, "account.style.apply.later") }</a>
						</div>
					</form>
				} else {
					<p>{ tn(ctx, "account.style.apply.none_ready", len(data.Surveys)) }</p>
					<div class="button-row">
						<a class="button secondary js-account-style-later" href="/account/style">{ t(ctx, "account.style.apply.back") }</a>
					</div>
				}
			</section>
		</main>
	}
}

// AccountStyleLanguages is where the account style's words are put in
// other languages (ADR-0023): once, for every survey that follows the
// account's style. Each language is a card worded as a survey's
// Languages tab words it, with its own save, since each is reviewed on
// its own.
templ AccountStyleLanguages(email string, workspaceName string, csrf string, data AccountStyleLanguagesData) {
	@Layout(t(ctx, "account.style.languages.title")) {
		@AuthedHeader(email, csrf)
		<main>
			<nav class="breadcrumb" aria-label={ t(ctx, "breadcrumb.aria") }>
				<a href="/account">{ t(ctx, "account.heading") }</a> /
				<a href="/account/style">{ t(ctx, "account.style.crumb") }</a> /
				{ t(ctx, "account.style.languages.crumb") }
			</nav>
			<h1>{ t(ctx, "account.style.languages.heading") }</h1>
			<p class="muted">{ t(ctx, "account.style.languages.intro") }</p>
			if data.Error != "" {
				<p class="notice error-text" role="alert">{ data.Error }</p>
			}
			if data.Notice != "" {
				<p class="notice" role="status">{ data.Notice }</p>
			}
			if !data.HasWords {
				<section class="card js-panel js-account-style-languages-empty">
					<p>{ t(ctx, "account.style.languages.empty.words") }</p>
					<p><a class="button secondary" href="/account/style">{ t(ctx, "account.style.languages.empty.back") }</a></p>
				</section>
			} else if len(data.Languages) == 0 {
				<section class="card js-panel js-account-style-languages-empty">
					<p>{ t(ctx, "account.style.languages.empty.languages") }</p>
					<p><a class="button secondary" href="/dashboard">{ t(ctx, "account.style.languages.empty.surveys") }</a></p>
				</section>
			} else {
				for _, lang := range data.Languages {
					@accountStyleLanguagePanel(csrf, data, lang)
				}
			}
		</main>
	}
}

templ accountStyleLanguagePanel(csrf string, data AccountStyleLanguagesData, lang AccountStyleLanguageView) {
	<section class="card js-panel js-account-style-language" id={ "lang-" + lang.Code }>
		<div class="title-row">
			<h2>{ lang.Label } <span class="muted">({ lang.Code })</span></h2>
			if lang.Style.Reviewed {
				<span class="chip chip-open">{ t(ctx, "languages.status.reviewed") }</span>
			} else {
				<span class="chip chip-draft">{ t(ctx, "account.style.languages.status.pending") }</span>
			}
		</div>
		if !lang.Carried {
			<p class="muted">{ t(ctx, "account.style.languages.status.unused", uitext.Args{"Language": lang.Name}) }</p>
		} else if lang.Style.Reviewed {
			<p class="muted">{ t(ctx, "account.style.languages.status.ready", uitext.Args{"Language": lang.Name}) }</p>
		} else {
			<p class="muted">{ t(ctx, "account.style.languages.status.blocked", uitext.Args{"Language": lang.Name}) }</p>
		}
		if lang.Style.Stale {
			<p class="notice">{ t(ctx, "account.style.languages.stale") }</p>
		} else if !lang.Style.Reviewed && !lang.Style.Words.IsZero() {
			<p class="muted">{ t(ctx, "languages.question.unreviewed") }</p>
		}
		if (data.CanTranslate && !lang.Style.Reviewed) || !lang.Carried {
			<div class="button-row">
				if data.CanTranslate && !lang.Style.Reviewed {
					<form method="post" action={ templ.SafeURL("/account/style/languages/" + lang.Code + "/draft") }>
						<input type="hidden" name="_csrf" value={ csrf }/>
						<input type="hidden" name="source" value={ data.Source }/>
						<button type="submit" class="secondary js-account-style-draft">{ t(ctx, "account.style.languages.draft.label") }</button>
					</form>
				}
				if !lang.Carried {
					<form method="post" action={ templ.SafeURL("/account/style/languages/" + lang.Code + "/remove") }>
						<input type="hidden" name="_csrf" value={ csrf }/>
						<button type="submit" class="button-link danger js-account-style-remove">{ t(ctx, "languages.remove.label", uitext.Args{"Language": lang.Name}) }</button>
					</form>
				}
			</div>
		}
		<form method="post" action={ templ.SafeURL("/account/style/languages/" + lang.Code) } class="js-account-style-translation">
			<input type="hidden" name="_csrf" value={ csrf }/>
			<input type="hidden" name="source" value={ data.Source }/>
			@styleWordsFields(lang.Name, lang.Style)
			<button type="submit">{ t(ctx, "languages.save.label") }</button>
		</form>
	</section>
}

// styleFormSummary is the head of a style form after a refused save: the
// problem, linked to the field it is in, and a word about files that
// have to be chosen again.
templ styleFormSummary(form StyleForm) {
	if form.Error != "" {
		<p class="notice error-text" role="alert">
			if form.errorTarget() != "" {
				<a class="js-style-error-link" href={ templ.SafeURL("#" + form.errorTarget()) }>{ form.Error }</a>
			} else {
				{ form.Error }
			}
			if form.FilesLost {
				<br/>
				{ t(ctx, "style.error.files_again") }
			}
		</p>
	}
}

// styleFormSections are every section of a style form, in the order a
// respondent's page has them: the theme, the header, the footer and the
// thanks page's picture.
templ styleFormSections(form StyleForm) {
	@styleThemeSection(form)
	@styleHeaderSection(form)
	@styleFooterSection(form)
	@styleThanksPanel(form)
}

// styleThemeSection is where the theme is chosen: each one a choice,
// with a small page drawn in it.
templ styleThemeSection(form StyleForm) {
	<section class="card js-panel" aria-labelledby="style-theme-heading">
		@styleSectionHeading(form, "style-theme-heading", t(ctx, "style.theme.heading"), form.Choice != nil && form.Choice.Own.Theme)
		<p class="muted" id="style-theme-hint">{ t(ctx, "style.theme.hint") }</p>
		<div class="theme-choices" role="radiogroup" aria-labelledby="style-theme-heading" aria-describedby="style-theme-hint">
			for _, theme := range domain.Themes() {
				<label class="choice theme-choice js-theme-choice">
					<input type="radio" name="theme" value={ theme } checked?={ theme == form.Style.ThemeName() } autocomplete="off"/>
					<span>
						<strong>{ t(ctx, themeName(theme)) }</strong>
						<small>{ t(ctx, themeHint(theme)) }</small>
					</span>
					@themeSample(theme)
				</label>
			}
		</div>
	</section>
}

// styleHeaderSection is the header: the banner and the logo, the logo's
// alternative text, the name, the tagline and the links.
templ styleHeaderSection(form StyleForm) {
	<section class="card js-panel js-style-header-panel switch-section" aria-labelledby="style-header-heading">
		if form.Choice != nil {
			@styleSwitchHeading(form, styleSwitch("header"), t(ctx, "style.header.heading"), form.Choice.Own.Header, !form.Choice.NoHeader)
			<p class="muted" id="style-header-hint">{ t(ctx, "style.header.hint") }</p>
		} else {
			@styleSectionHeading(form, "style-header-heading", t(ctx, "style.header.heading"), false)
			if form.Account {
				<p class="muted">{ t(ctx, "account.style.header_hint") }</p>
			} else {
				<p class="muted">{ t(ctx, "style.header.hint") }</p>
			}
		}
		<div class="switch-fields">
			@styleImageField(form, styleImageFieldData{
				Field:   "banner",
				Part:    domain.StyleBanner,
				Hint:    t(ctx, "style.header.banner_hint", uitext.Args{"Size": styleimage.Banner.MaxUpload >> 20}),
				Current: form.Style.Header.Banner,
			})
			@styleImageField(form, styleImageFieldData{
				Field:   "logo",
				Part:    domain.StyleLogo,
				Hint:    t(ctx, "style.header.logo_hint", uitext.Args{"Size": styleimage.Logo.MaxUpload >> 20}),
				Current: form.Style.Header.Logo,
				Plate:   true,
			})
			<label class="field">
				<span>
					@thtml(ctx, "style.header.logo_alt_html")
				</span>
				<input
					type="text"
					name="logo_alt"
					class="js-style-logo-alt"
					value={ form.Style.Header.LogoAlt }
					maxlength="120"
					autocomplete="off"
					data-1p-ignore
					data-lpignore="true"
					data-bwignore
					if form.problemIn(domain.StyleLogoAlt) {
						id="style-invalid"
						aria-invalid="true"
						aria-describedby="style-error-field"
					}
				/>
			</label>
			if form.problemIn(domain.StyleLogoAlt) {
				@styleFieldError(form)
			}
			<label class="field">
				<span>
					@thtml(ctx, "style.header.name_html")
				</span>
				<input
					type="text"
					name="header_name"
					value={ form.Style.Header.Name }
					maxlength="80"
					autocomplete="off"
					data-1p-ignore
					data-lpignore="true"
					data-bwignore
					if form.problemIn(domain.StyleHeaderName) {
						id="style-invalid"
						aria-invalid="true"
						aria-describedby="style-error-field"
					}
				/>
			</label>
			if form.problemIn(domain.StyleHeaderName) {
				@styleFieldError(form)
			}
			<label class="field">
				<span>
					@thtml(ctx, "style.header.tagline_html")
				</span>
				<textarea
					name="header_tagline"
					rows="3"
					maxlength="280"
					autocomplete="off"
					data-1p-ignore
					data-lpignore="true"
					data-bwignore
					if form.problemIn(domain.StyleHeaderText) {
						id="style-invalid"
						aria-invalid="true"
						aria-describedby="style-error-field"
					}
				>{ form.Style.Header.Tagline }</textarea>
			</label>
			if form.problemIn(domain.StyleHeaderText) {
				@styleFieldError(form)
			}
			@styleLinkFields(form, "header", domain.StyleHeaderLinks, form.Style.Header.Links)
		</div>
	</section>
}

// styleFooterSection is the creator's footer: its text and its links.
templ styleFooterSection(form StyleForm) {
	<section class="card js-panel js-style-footer-panel switch-section" aria-labelledby="style-footer-heading">
		if form.Choice != nil {
			@styleSwitchHeading(form, styleSwitch("footer"), t(ctx, "style.footer.heading"), form.Choice.Own.Footer, !form.Choice.NoFooter)
			<p class="muted" id="style-footer-hint">{ t(ctx, "style.footer.hint") }</p>
		} else {
			@styleSectionHeading(form, "style-footer-heading", t(ctx, "style.footer.heading"), false)
			if form.Account {
				<p class="muted">{ t(ctx, "account.style.footer_hint") }</p>
			} else {
				<p class="muted">{ t(ctx, "style.footer.hint") }</p>
			}
		}
		<div class="switch-fields">
			<label class="field">
				<span>
					@thtml(ctx, "style.footer.text_html")
				</span>
				<textarea
					name="footer_text"
					rows="3"
					maxlength="280"
					autocomplete="off"
					data-1p-ignore
					data-lpignore="true"
					data-bwignore
					if form.problemIn(domain.StyleFooterText) {
						id="style-invalid"
						aria-invalid="true"
						aria-describedby="style-error-field"
					}
				>{ form.Style.Footer.Text }</textarea>
			</label>
			if form.problemIn(domain.StyleFooterText) {
				@styleFieldError(form)
			}
			@styleLinkFields(form, "footer", domain.StyleFooterLinks, form.Style.Footer.Links)
		</div>
	</section>
}

// styleThanksPanel is where the thanks page's picture is chosen: the
// owl, one of the three drawings, the creator's own picture or none,
// each a choice with the picture drawn small. The file field under the
// choices is for "your own picture"; choosing a file there picks it.
templ styleThanksPanel(form StyleForm) {
	<section class="card js-panel js-style-thanks-panel" aria-labelledby="style-thanks-heading">
		@styleSectionHeading(form, "style-thanks-heading", t(ctx, "style.thanks.heading"), form.Choice != nil && form.Choice.Own.Thanks)
		<p class="muted" id="style-thanks-hint">{ t(ctx, "style.thanks.hint") }</p>
		if form.problemIn(domain.StyleThanksPicture) {
			@styleFieldError(form)
		}
		<div class="thanks-choices" role="radiogroup" aria-labelledby="style-thanks-heading" aria-describedby="style-thanks-hint">
			for _, picture := range domain.ThanksPictures() {
				<label class="choice thanks-choice js-thanks-choice">
					<input type="radio" name="thanks_picture" value={ picture } checked?={ picture == form.Style.Thanks.PictureName() } autocomplete="off"/>
					<span><strong>{ t(ctx, thanksPictureName(picture)) }</strong></span>
					@thanksChoicePreview(picture, form.Style)
				</label>
			}
		</div>
		@styleImageField(form, styleImageFieldData{
			Field:   "thanks_image",
			Part:    domain.StyleThanksImage,
			Hint:    t(ctx, "style.thanks.image_hint", uitext.Args{"Size": styleimage.Thanks.MaxUpload >> 20}),
			Current: form.Style.Thanks.Image,
			Plate:   true,
		})
		<label class="field">
			<span>
				@thtml(ctx, "style.thanks.alt_html")
			</span>
			<input
				type="text"
				name="thanks_alt"
				class="js-style-thanks-alt"
				value={ form.Style.Thanks.Alt }
				maxlength="120"
				autocomplete="off"
				data-1p-ignore
				data-lpignore="true"
				data-bwignore
				if form.problemIn(domain.StyleThanksAlt) {
					id="style-invalid"
					aria-invalid="true"
					aria-describedby="style-error-field"
				}
			/>
		</label>
		if form.problemIn(domain.StyleThanksAlt) {
			@styleFieldError(form)
		}
	</section>
}

// styleSectionHeading is a section's heading. On a survey's Style tab,
// under an account that has a style, a chip beside it says whether the
// part is the survey's own or comes from the account's style (ADR-0023).
templ styleSectionHeading(form StyleForm, id string, heading string, own bool) {
	if form.sourceShown() {
		<div class="title-row">
			<h2 id={ id }>{ heading }</h2>
			<span class="chip js-style-source">{ t(ctx, partSource(own)) }</span>
		</div>
	} else {
		<h2 id={ id }>{ heading }</h2>
	}
}

// styleSwitchHeading is the title line of a survey's header or footer
// section: a switch, the heading that names it, and where the part comes
// from. On, the survey shows the part and the section's fields are shown;
// off, it shows none and the stylesheet hides the fields, with no script.
// An unticked switch posts nothing, so a marker beside it says it was
// offered, and the server reads no field of a section switched off.
templ styleSwitchHeading(form StyleForm, part styleSwitch, heading string, own bool, shown bool) {
	<div class="title-row switch-title">
		<input type="hidden" name={ part.offered() } value="1"/>
		<span class="switch">
			<input
				type="checkbox"
				role="switch"
				class={ "switch-input", part.hook() }
				id={ part.id() }
				name={ part.field() }
				value="1"
				checked?={ shown }
				autocomplete="off"
				aria-describedby={ part.hintID() }
			/>
			<span class="switch-track" aria-hidden="true"></span>
		</span>
		<h2 id={ part.headingID() }><label for={ part.id() }>{ heading }</label></h2>
		if form.sourceShown() {
			<span class="chip js-style-source">{ t(ctx, partSource(own)) }</span>
		}
	</div>
}

// styleFieldError words the refused save's problem beside the field it
// is in. The summary at the head of the form is the alert; this is what
// the field is described by.
templ styleFieldError(form StyleForm) {
	<p class="error-text js-style-field-error" id="style-error-field">{ form.FieldError }</p>
}

// styleImageField is a file field for one of the style's pictures, with
// the picture the draft has now and a box that removes it. A field left
// empty keeps the picture: a browser cannot fill a file field in, so an
// empty one says nothing about what is stored. The current picture is
// shown from the creator's own address, and has no alternative text
// here: the field's label says which picture it is.
templ styleImageField(form StyleForm, field styleImageFieldData) {
	<div class={ "field", "style-image-field", field.hook() }>
		<label for={ field.id() }>
			<span>
				@thtml(ctx, field.labelID())
			</span>
		</label>
		<input
			type="file"
			id={ field.id() }
			name={ field.Field }
			accept={ styleImageAccept }
			if form.problemIn(field.Part) {
				aria-invalid="true"
			}
			aria-describedby={ field.describedBy(form.problemIn(field.Part)) }
		/>
		<small id={ field.hintID() }>{ field.Hint }</small>
		if form.problemIn(field.Part) {
			@styleFieldError(form)
		}
		if !field.Current.IsZero() {
			<div class="style-image-current">
				<span class={ "style-image-thumb", templ.KV("style-logo", field.Plate) }>
					<img
						class="js-style-image-current"
						src={ styleImageURL(ctx, field.Current) }
						alt=""
						width={ strconv.Itoa(field.Current.Width) }
						height={ strconv.Itoa(field.Current.Height) }
						decoding="async"
					/>
				</span>
				<label class="checkbox">
					<input type="checkbox" name={ field.removeName() } value="1" autocomplete="off"/>
					<span>{ t(ctx, field.removeID()) }</span>
				</label>
			</div>
		}
	</div>
}

// styleLinkFields are the rows of links of a header or a footer: a label
// and an address for each, every row optional. A row left empty is
// dropped when the form is saved. Each field is named by its row, since
// three fields called "Label" tell a screen reader nothing apart.
templ styleLinkFields(form StyleForm, where string, part domain.StylePart, links []domain.StyleLink) {
	<fieldset class="field style-links-fields">
		<legend>{ t(ctx, "style.links.legend") }</legend>
		<p class="muted">{ t(ctx, "style.links.hint") }</p>
		if form.problemIn(part) && form.ErrorLink == 0 {
			@styleFieldError(form)
		}
		for i, link := range styleLinkRows(links) {
			<div class="field-row">
				<label class="field">
					<span>{ t(ctx, "style.links.label", uitext.Args{"Position": i + 1}) }</span>
					<input
						type="text"
						name={ where + "_link_label" }
						value={ link.Label }
						maxlength="60"
						autocomplete="off"
						data-1p-ignore
						data-lpignore="true"
						data-bwignore
						if form.problemIn(part) && form.ErrorLink == i+1 {
							id="style-invalid"
							aria-invalid="true"
							aria-describedby="style-error-field"
						}
					/>
				</label>
				<label class="field">
					<span>{ t(ctx, "style.links.address", uitext.Args{"Position": i + 1}) }</span>
					<input
						type="url"
						name={ where + "_link_url" }
						value={ link.URL }
						maxlength="2000"
						inputmode="url"
						autocomplete="off"
						data-1p-ignore
						data-lpignore="true"
						data-bwignore
						if form.problemIn(part) && form.ErrorLink == i+1 {
							aria-invalid="true"
							aria-describedby="style-error-field"
						}
					/>
				</label>
			</div>
			if form.problemIn(part) && form.ErrorLink == i+1 {
				@styleFieldError(form)
			}
		}
	</fieldset>
}

// themeSample is a small page in a theme's own tokens: its ground, a
// card on it, lines where text, muted text and a link would be, and the
// shape of its filled button. It is a picture, hidden from a screen
// reader, which is told the theme by its name and its line beside it.
// It is drawn in the display mode the creator is reading in, since the
// theme class sets both.
templ themeSample(theme string) {
	<span class={ "theme-sample", themeClass(domain.Style{Theme: theme}) } aria-hidden="true">
		<span class="theme-sample-card">
			<span class="theme-sample-text"></span>
			<span class="theme-sample-muted"></span>
			<span class="theme-sample-link"></span>
			<span class="theme-sample-button"></span>
		</span>
	</span>
}

// ThemeSheetData is the theme sheet: Respond holds sample questions with
// sample answers and one error, Answers a submission read back, Thanks a
// creator's message and link, and Focus the words of the controls drawn
// with their focus ring showing. The sample wording is the handler's,
// as a survey's is its creator's.
type ThemeSheetData struct {
	Respond RespondData
	Answers []AnsweredQuestion
	Thanks  domain.ThankYou
	Focus   ThemeSheetFocus
}

// ThemeSheetFocus words the controls the sheet draws as if focused.
type ThemeSheetFocus struct {
	Question string
	Field    string
	Option   string
}

// ThemeSheet puts every component a respondent's page can show on one
// page, in one theme, so that the theme can be looked at, and scanned,
// as a whole (docs/style-guide.md, "Themes"). It is served in
// development only. The questions are drawn by the respondent's own
// templates, and what a script would build on a live page, the progress
// and the dictation card, is written here with the classes the script
// gives it, since no script runs a microphone on a sheet.
templ ThemeSheet(data ThemeSheetData) {
	@RespondLayout(data.Respond.Title, "", data.Respond.Style, HeaderFull) {
		<main>
			<nav class="tabs" aria-label={ t(ctx, "style.theme.heading") }>
				for _, theme := range domain.Themes() {
					<a
						href={ templ.SafeURL("/dev/theme-sheet?theme=" + theme) }
						if theme == data.Respond.Style.ThemeName() {
							aria-current="page"
						}
					>{ t(ctx, themeName(theme)) }</a>
				}
			</nav>
			<h1>{ data.Respond.Title }</h1>
			@respondentDisclosure(data.Respond)
			<p class="notice">{ t(ctx, "respond.before.note") }</p>
			<div class="error-summary" role="alert" tabindex="-1" id="error-summary">
				<h2>{ tn(ctx, "respond.errors.heading", len(data.Respond.ErrorList)) }</h2>
				<ul>
					for _, e := range data.Respond.ErrorList {
						<li><a href={ templ.SafeURL("#q-" + e.IdentityID) }>{ t(ctx, "respond.errors.item", uitext.Args{"Position": e.Position, "Problem": e.Message}) }</a></li>
					}
				</ul>
			</div>
			<p class="respond-progress">{ t(ctx, "respond.question.position", uitext.Args{"Current": 2, "Total": len(data.Respond.Questions)}) }</p>
			<progress class="respond-meter" max={ strconv.Itoa(len(data.Respond.Questions)) } value="2" aria-hidden="true"></progress>
			<form class="respond-form" method="get" action="/dev/theme-sheet" novalidate>
				<input type="hidden" name="theme" value={ data.Respond.Style.ThemeName() }/>
				<ol class="respond-questions">
					for i, q := range data.Respond.Questions {
						@respondQuestion(q, i, len(data.Respond.Questions), data.Respond)
					}
					<li class="respond-question">
						<fieldset>
							@themeSheetVoice("idle")
						</fieldset>
					</li>
					<li class="respond-question">
						<fieldset>
							@themeSheetVoice("recording")
						</fieldset>
					</li>
					<li class="respond-question">
						<fieldset>
							<legend><span class="q-text" id="sheet-focus-legend">{ data.Focus.Question }</span></legend>
							<input type="text" class="focus-shown" value={ data.Focus.Field } aria-labelledby="sheet-focus-legend" autocomplete="off"/>
						</fieldset>
					</li>
					<li class="respond-question">
						<fieldset>
							<legend><span class="q-text">{ data.Focus.Question }</span></legend>
							<div class="options">
								<label class="option focus-shown">
									<input type="radio" name="sheet_focus" value="1" autocomplete="off"/>
									<span>{ data.Focus.Option }</span>
								</label>
							</div>
						</fieldset>
					</li>
				</ol>
				<div class="respond-nav">
					<button type="button" class="secondary focus-shown">{ t(ctx, "js.respond.back") }</button>
					<button type="submit" class="respond-submit focus-shown">
						<span class="button-label">{ t(ctx, "respond.submit.label") }</span>
					</button>
				</div>
			</form>
			<div class="standalone">
				<div class="thanks-drawings">
					for _, picture := range domain.ThanksPictures() {
						if picture == domain.ThanksOwl {
							@owl(OwlHappy, 96)
						} else if (domain.StyleThanks{Picture: picture}).Drawing() {
							@thanksDrawing(picture, 96)
						}
					}
				</div>
				@thanksMessage(data.Thanks)
				<p><a class="button secondary" href={ templ.URL(data.Thanks.LinkURL) } rel="noopener noreferrer">{ data.Thanks.LinkLabel }</a></p>
				<p class="muted">{ t(ctx, "respond.thanks.anonymous") }</p>
				@answerSummary(data.Answers)
			</div>
		</main>
	}
}

// themeSheetVoice is the dictation card as voice.js builds it, waiting
// and with the microphone open, where Signal is the colour of the
// button, the status and the field the words land in.
templ themeSheetVoice(state string) {
	<textarea
		rows="2"
		aria-label={ t(ctx, "js.voice.title") }
		autocomplete="off"
		if state == "recording" {
			class="is-live"
			placeholder={ t(ctx, "js.voice.recording") }
		}
	></textarea>
	<div class="voice" data-state={ state } role="group" aria-label={ t(ctx, "js.voice.title") }>
		<div class="voice-head">
			<span class="voice-mark">
				@owl(OwlListening, 22)
				<span class="voice-title">{ t(ctx, "js.voice.title") }</span>
			</span>
			<button type="button" class="voice-toggle">{ t(ctx, "js.voice.hide") }</button>
		</div>
		<div class="voice-body">
			<div class="voice-status">
				<span class="voice-status-text">
					if state == "recording" {
						{ t(ctx, "js.voice.recording") }
					} else {
						{ t(ctx, "js.voice.hint.longer") }
					}
				</span>
			</div>
			<div class="voice-actions">
				<button type="button" class={ "voice-button", "secondary", templ.KV("is-recording", state == "recording") }>
					<svg class="voice-icon" viewBox="0 0 24 24" aria-hidden="true" focusable="false">
						<path d="M12 3a3 3 0 0 1 3 3v6a3 3 0 0 1-6 0V6a3 3 0 0 1 3-3z"></path>
						<path d="M6 11a6 6 0 0 0 12 0"></path>
						<path d="M12 17v4"></path>
						<path d="M9 21h6"></path>
					</svg>
					if state == "recording" {
						{ t(ctx, "js.voice.stop") }
					} else {
						{ t(ctx, "js.voice.dictate") }
					}
				</button>
				<button type="button" class="voice-reset secondary">{ t(ctx, "js.voice.reset") }</button>
			</div>
		</div>
	</div>
}
