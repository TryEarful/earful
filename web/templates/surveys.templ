package templates

import (
	"context"
	"fmt"
	"strings"

	"github.com/TryEarful/earful/internal/domain"
	"github.com/TryEarful/earful/internal/uitext"
	"github.com/TryEarful/earful/web/static"
)

// responseCountLabel is "1 response", "5 responses": how many times a
// survey has been submitted, wherever that is said.
func responseCountLabel(ctx context.Context, n int) string {
	return tn(ctx, "survey.responses", n)
}

// statusClass maps a Survey Status onto its chip styling.
func statusClass(s domain.Status) string {
	switch s {
	case domain.StatusOpen:
		return "chip chip-open"
	case domain.StatusClosed:
		return "chip chip-closed"
	default:
		return "chip chip-draft"
	}
}

templ StatusChip(s domain.Status) {
	<span class={ statusClass(s) }>{ statusName(ctx, s) }</span>
}

// Every field an author types into, here and across the editor, carries
// autocomplete="off" and the password manager opt outs, for the reason
// given at answerControl: survey wording is never a login, and a value
// the browser remembers from another survey does not belong in this one.
//
// With AI on, the title is optional: a description alone is enough, and
// the model proposes the title from it. The server still refuses a form
// with neither.
templ NewSurvey(email string, workspaceName string, csrf string, data NewSurveyData) {
	@Layout(t(ctx, "survey.new.title")) {
		@AuthedHeader(email, csrf)
		<main>
			<h1>{ t(ctx, "survey.new.heading") }</h1>
			<form method="post" action="/surveys" class="card js-panel js-new-survey">
				<input type="hidden" name="_csrf" value={ csrf }/>
				<label class="field">
					<span>{ t(ctx, "survey.name.label") }</span>
					<input type="text" name="title" value={ data.Title } required?={ !data.AIEnabled } autofocus maxlength="200" autocomplete="off" data-1p-ignore data-lpignore="true" data-bwignore/>
				</label>
				if data.AIEnabled {
					// The hint sits outside the label and describes the field,
					// so the field's name stays the short label alone.
					<div class="field">
						<label for="new-survey-prompt"><span>{ t(ctx, "survey.new.prompt.label") }</span></label>
						<textarea
							id="new-survey-prompt"
							aria-describedby="new-survey-prompt-hint"
							name="prompt"
							class="js-new-survey-prompt"
							rows="3"
							maxlength="1000"
							autocomplete="off"
							data-1p-ignore
							data-lpignore="true"
							data-bwignore
							placeholder={ t(ctx, "editor.generate.prompt.placeholder") }
						>{ data.Prompt }</textarea>
						<small id="new-survey-prompt-hint">{ t(ctx, "survey.new.prompt.hint") }</small>
					</div>
				}
				<fieldset class="field">
					<legend>{ t(ctx, "survey.audience.legend") }</legend>
					<label class="choice">
						<input type="radio" name="anonymity" value="anonymous" checked?={ data.Anonymous } autocomplete="off"/>
						<span>
							<strong>{ t(ctx, "survey.audience.anonymous.name") }</strong>
							<small>{ t(ctx, "survey.audience.anonymous.hint") }</small>
						</span>
					</label>
					<label class="choice">
						<input type="radio" name="anonymity" value="invited" checked?={ !data.Anonymous } autocomplete="off"/>
						<span>
							<strong>{ t(ctx, "survey.audience.invited.name") }</strong>
							<small>{ t(ctx, "survey.audience.invited.hint") }</small>
						</span>
					</label>
					<p class="warn">{ t(ctx, "survey.audience.permanent") }</p>
				</fieldset>
				<label class="field">
					<span>
						@thtml(ctx, "survey.close_date.label_html")
					</span>
					<input type="date" name="close_at" value={ data.CloseAt } autocomplete="off"/>
				</label>
				if data.Error != "" {
					<p class="error-text js-new-survey-error">{ data.Error }</p>
				}
				<button type="submit">{ t(ctx, "survey.new.submit.label") }</button>
				<a class="button secondary" href="/surveys">{ t(ctx, "survey.new.cancel.label") }</a>
			</form>
		</main>
	}
}

templ SurveyEditor(email string, workspaceName string, csrf string, data SurveyEditorData) {
	@Layout(t(ctx, "page.title", uitext.Args{"Title": data.Survey.Title})) {
		@AuthedHeader(email, csrf)
		<main>
			<nav class="breadcrumb" aria-label={ t(ctx, "breadcrumb.aria") }><a href="/surveys">{ t(ctx, "breadcrumb.surveys") }</a> / { data.Survey.Title }</nav>
			<div class="title-row editor-title">
				<h1>{ data.Survey.Title }</h1>
				<a class="button secondary" href={ templ.SafeURL("/surveys/" + data.Survey.ID + "/preview") }>{ t(ctx, "editor.preview.label") }</a>
				<p class="muted survey-meta">
					@StatusChip(data.Survey.Status)
					if data.Survey.IsAnonymous {
						{ t(ctx, "survey.audience.anonymous.name") }
					} else {
						{ t(ctx, "survey.audience.invited.name") }
					}
					{ t(ctx, "editor.created", uitext.Args{"Date": data.Survey.CreatedAt}) }
					if data.Survey.Published() {
						{ t(ctx, "editor.live", uitext.Args{"Version": data.Survey.LatestVersion}) } ·
						if data.ResponseCount > 0 {
							<a href={ templ.SafeURL("/surveys/" + data.Survey.ID + "/results") }>{ responseCountLabel(ctx, data.ResponseCount) }</a>
						} else {
							{ responseCountLabel(ctx, data.ResponseCount) }
						}
					}
				</p>
			</div>
			@surveyTabs(data.Survey, "questions")
			if data.Notice != "" {
				<p class="notice" role="status">{ data.Notice }</p>
			}
			if data.Error != "" {
				<p class="notice error-text">{ data.Error }</p>
			}
			@lifecyclePanel(csrf, data.Survey, data.Origin)
			if len(data.Questions) > 0 {
				<section class="card js-panel">
					<h2>{ t(ctx, "editor.questions.heading") }</h2>
					<ol class="questions js-questions">
						for i, q := range data.Questions {
							@questionRow(csrf, data.Survey.ID, q, i, len(data.Questions))
						}
					</ol>
				</section>
			}
			if data.AIEnabled {
				@generatePanel(csrf, data.Survey.ID)
			}
			@addQuestionForm(csrf, data.Survey.ID, len(data.Questions) == 0)
			if !data.Survey.IsAnonymous {
				@participantsPanel(csrf, data)
			}
			if !data.Survey.Published() || data.DraftChanged {
				@publishPanel(csrf, data.Survey, len(data.Questions), data.DraftChanged)
			}
			@versionsPanel(data.Survey, data.Versions, data.DraftChanged)
			@settingsPanel(csrf, data.Survey)
		</main>
		<script src={ static.AssetURL("js/share.js") } defer></script>
		if data.AIEnabled {
			@jsText(ctx, "js.generate")
			<script src={ static.AssetURL("js/uitext.js") } defer></script>
			<script src={ static.AssetURL("js/wsclient.js") } defer></script>
			<script src={ static.AssetURL("js/generate.js") } defer></script>
		}
	}
}

templ questionRow(csrf string, surveyID string, q domain.Question, index int, total int) {
	<li class="question js-question">
		<details>
			<summary>
				<span class="qtype">{ typeName(ctx, q.Type) }</span>
				<span class="qtext">{ q.Text }</span>
				if q.Required {
					<span class="chip chip-small">{ t(ctx, "editor.question.required") }</span>
				}
			</summary>
			<form method="post" action={ templ.SafeURL(fmt.Sprintf("/surveys/%s/questions/%s", surveyID, q.IdentityID)) }>
				<input type="hidden" name="_csrf" value={ csrf }/>
				<input type="hidden" name="type" value={ string(q.Type) }/>
				<label class="field">
					<span>{ t(ctx, "editor.question.text") }</span>
					<input type="text" name="text" value={ q.Text } required maxlength="500" autocomplete="off" data-1p-ignore data-lpignore="true" data-bwignore/>
				</label>
				if q.Type.NeedsOptions() {
					<label class="field">
						<span>
							@thtml(ctx, "editor.question.options_html")
						</span>
						<textarea name="options" autocomplete="off" data-1p-ignore data-lpignore="true" data-bwignore rows="4">{ strings.Join(q.Options, "\n") }</textarea>
					</label>
				}
				if q.Type.NeedsScale() {
					<div class="field-row">
						<label class="field">
							<span>{ t(ctx, "editor.question.scale_min") }</span>
							<input type="number" name="scale_min" min="0" max="1" value={ fmt.Sprint(q.ScaleMin) } autocomplete="off"/>
						</label>
						<label class="field">
							<span>{ t(ctx, "editor.question.scale_max") }</span>
							<input type="number" name="scale_max" min="2" max="10" value={ fmt.Sprint(q.ScaleMax) } autocomplete="off"/>
						</label>
					</div>
				}
				<label class="checkbox">
					if q.Required {
						<input type="checkbox" name="required" checked autocomplete="off"/>
					} else {
						<input type="checkbox" name="required" autocomplete="off"/>
					}
					<span>{ t(ctx, "editor.question.required") }</span>
				</label>
				<button type="submit" class="secondary">{ t(ctx, "editor.question.save.label") }</button>
			</form>
			<div class="question-actions">
				if index > 0 {
					<form method="post" action={ templ.SafeURL(fmt.Sprintf("/surveys/%s/questions/%s/move", surveyID, q.IdentityID)) }>
						<input type="hidden" name="_csrf" value={ csrf }/>
						<input type="hidden" name="direction" value="up"/>
						<button type="submit" class="secondary">{ t(ctx, "editor.question.up.label") }</button>
					</form>
				}
				if index < total-1 {
					<form method="post" action={ templ.SafeURL(fmt.Sprintf("/surveys/%s/questions/%s/move", surveyID, q.IdentityID)) }>
						<input type="hidden" name="_csrf" value={ csrf }/>
						<input type="hidden" name="direction" value="down"/>
						<button type="submit" class="secondary">{ t(ctx, "editor.question.down.label") }</button>
					</form>
				}
				<form method="post" action={ templ.SafeURL(fmt.Sprintf("/surveys/%s/questions/%s/delete", surveyID, q.IdentityID)) }>
					<input type="hidden" name="_csrf" value={ csrf }/>
					<button type="submit" class="secondary danger">{ t(ctx, "editor.question.delete.label") }</button>
				</form>
			</div>
		</details>
	</li>
}

// generatePanel is M6-T3's entrance. The form works on its own: without
// JavaScript it posts, waits, and comes back with the questions added.
// generate.js upgrades it to a live stream against the same handler.
templ generatePanel(csrf string, surveyID string) {
	<section class="card js-panel" id="ai-generate">
		<h2>{ t(ctx, "editor.generate.heading") }</h2>
		<p class="muted">
			{ t(ctx, "editor.generate.intro") }
		</p>
		<form
			method="post"
			action={ templ.SafeURL("/surveys/" + surveyID + "/generate") }
			class="generate-form js-generate-form"
			data-generate-path={ "/surveys/" + surveyID + "/generate/stream" }
		>
			<input type="hidden" name="_csrf" value={ csrf }/>
			<label class="field">
				<span>{ t(ctx, "editor.generate.prompt.label") }</span>
				<textarea
					name="prompt"
					rows="3"
					maxlength="1000"
					autocomplete="off"
					data-1p-ignore
					data-lpignore="true"
					data-bwignore
					placeholder={ t(ctx, "editor.generate.prompt.placeholder") }
				></textarea>
			</label>
			<button type="submit" class="secondary">{ t(ctx, "editor.generate.submit.label") }</button>
		</form>
		<pre class="generate-output js-generate-output" aria-live="polite" hidden></pre>
	</section>
}

// addQuestionForm is the page's main action while the survey has no
// questions, and one action among others once it has.
templ addQuestionForm(csrf string, surveyID string, first bool) {
	<section class="card js-panel">
		<h2>{ t(ctx, "editor.add.heading") }</h2>
		if first {
			<p class="muted">{ t(ctx, "editor.questions.empty") }</p>
		}
		<form method="post" action={ templ.SafeURL("/surveys/" + surveyID + "/questions") }>
			<input type="hidden" name="_csrf" value={ csrf }/>
			<label class="field">
				<span>{ t(ctx, "editor.add.type") }</span>
				<select name="type" required>
					for _, kind := range domain.QuestionTypes {
						<option value={ string(kind) } title={ typeHint(ctx, kind) }>{ typeName(ctx, kind) }</option>
					}
				</select>
			</label>
			<label class="field">
				<span>{ t(ctx, "editor.question.text") }</span>
				<input type="text" name="text" required maxlength="500" placeholder={ t(ctx, "editor.add.text.placeholder") } autocomplete="off" data-1p-ignore data-lpignore="true" data-bwignore/>
			</label>
			<label class="field q-options">
				<span>
					@thtml(ctx, "editor.add.options_html")
				</span>
				<textarea name="options" autocomplete="off" data-1p-ignore data-lpignore="true" data-bwignore rows="3"></textarea>
			</label>
			<div class="field-row q-scale">
				<label class="field">
					<span>
						@thtml(ctx, "editor.add.scale_min_html")
					</span>
					<input type="number" name="scale_min" min="0" max="1" value="1" autocomplete="off"/>
				</label>
				<label class="field">
					<span>
						@thtml(ctx, "editor.add.scale_max_html")
					</span>
					<input type="number" name="scale_max" min="2" max="10" value="5" autocomplete="off"/>
				</label>
			</div>
			<label class="checkbox">
				<input type="checkbox" name="required" autocomplete="off"/>
				<span>{ t(ctx, "editor.question.required") }</span>
			</label>
			<button type="submit" class={ templ.KV("secondary", !first) }>{ t(ctx, "editor.add.submit.label") }</button>
		</form>
	</section>
}

templ participantsPanel(csrf string, data SurveyEditorData) {
	<section class="card js-panel">
		<h2>{ t(ctx, "editor.participants.heading") }</h2>
		if len(data.Participants) == 0 {
			<p class="muted">{ t(ctx, "editor.participants.empty") }</p>
		} else {
			<ul class="participants">
				for _, p := range data.Participants {
					<li>
						<span>{ p.Email }</span>
						<span class="chip chip-small">{ p.Status }</span>
					</li>
				}
			</ul>
		}
		<form method="post" action={ templ.SafeURL("/surveys/" + data.Survey.ID + "/participants") } enctype="multipart/form-data">
			<input type="hidden" name="_csrf" value={ csrf }/>
			<label class="field">
				<span>
					@thtml(ctx, "editor.participants.emails_html")
				</span>
				<textarea name="emails" autocomplete="off" data-1p-ignore data-lpignore="true" data-bwignore rows="3" placeholder="ada@example.org&#10;grace@example.org"></textarea>
			</label>
			<label class="field">
				<span>{ t(ctx, "editor.participants.csv") }</span>
				<input type="file" name="csv" accept=".csv,text/csv"/>
			</label>
			<button type="submit" class="secondary">{ t(ctx, "editor.participants.add.label") }</button>
		</form>
		if data.PendingCount > 0 {
			<form method="post" action={ templ.SafeURL("/surveys/" + data.Survey.ID + "/participants/send") }>
				<input type="hidden" name="_csrf" value={ csrf }/>
				<button type="submit">
					{ tn(ctx, "editor.participants.send", data.PendingCount) }
				</button>
			</form>
			<p class="muted">{ t(ctx, "editor.participants.drip") }</p>
		}
	</section>
}

templ publishPanel(csrf string, survey SurveyView, questionCount int, changed bool) {
	<section class="card js-panel">
		<h2>{ t(ctx, "editor.publish.heading") }</h2>
		switch {
			case questionCount == 0:
				<p class="muted">{ t(ctx, "editor.publish.empty") }</p>
			case !changed:
				<p class="muted">{ t(ctx, "editor.publish.current", uitext.Args{"Version": survey.LatestVersion}) }</p>
			default:
				if survey.Published() {
					<p>{ t(ctx, "editor.publish.live", uitext.Args{"Version": survey.LatestVersion}) }</p>
				} else {
					<p>{ t(ctx, "editor.publish.never") }</p>
				}
				<form method="post" action={ templ.SafeURL("/surveys/" + survey.ID + "/publish") }>
					<input type="hidden" name="_csrf" value={ csrf }/>
					<button type="submit">
						{ t(ctx, "editor.publish.submit.label", uitext.Args{"Version": survey.LatestVersion + 1}) }
					</button>
				</form>
		}
	</section>
}

templ lifecyclePanel(csrf string, survey SurveyView, origin string) {
	if survey.Published() {
		<section class="card js-panel">
			<h2>{ t(ctx, "editor.sharing.heading") }</h2>
			switch survey.Status {
				case domain.StatusOpen:
					<p>{ t(ctx, "editor.sharing.open") }</p>
					<div class="share-row">
						<p class="share-link js-share-link"><a href={ templ.SafeURL(survey.ShareURL()) }>{ origin + survey.ShareURL() }</a></p>
						<button type="button" class="secondary js-copy-link" data-copy={ origin + survey.ShareURL() } data-done={ t(ctx, "editor.sharing.copied") } hidden>{ t(ctx, "editor.sharing.copy") }</button>
					</div>
					if survey.IsAnonymous {
						<p class="muted">{ t(ctx, "editor.sharing.anonymous") }</p>
					} else {
						<p class="muted">{ t(ctx, "editor.sharing.invited") }</p>
					}
					<form method="post" action={ templ.SafeURL("/surveys/" + survey.ID + "/close") }>
						<input type="hidden" name="_csrf" value={ csrf }/>
						<button type="submit" class="secondary">{ t(ctx, "editor.sharing.close.label") }</button>
					</form>
				case domain.StatusClosed:
					if survey.ManuallyClosed {
						<p>{ t(ctx, "editor.sharing.closed") }</p>
					} else {
						<p>{ t(ctx, "editor.sharing.closed_on", uitext.Args{"Date": survey.CloseAtLabel}) }</p>
					}
					<form method="post" action={ templ.SafeURL("/surveys/" + survey.ID + "/reopen") }>
						<input type="hidden" name="_csrf" value={ csrf }/>
						<button type="submit" class="secondary">{ t(ctx, "editor.sharing.reopen.label") }</button>
					</form>
					if !survey.ManuallyClosed {
						<p class="muted">{ t(ctx, "editor.sharing.reopen.hint") }</p>
					}
			}
		</section>
	}
}

// versionsPanel lists the published versions. Where the draft matches
// the live one it also says so, in place of a Publish card with nothing
// to publish.
templ versionsPanel(survey SurveyView, versions []VersionView, changed bool) {
	if len(versions) > 0 {
		<section class="card js-panel">
			<h2>{ t(ctx, "editor.versions.heading") }</h2>
			if !changed {
				<p class="muted">{ t(ctx, "editor.publish.current", uitext.Args{"Version": survey.LatestVersion}) }</p>
			}
			<ul class="versions">
				for _, v := range versions {
					<li>
						<strong>{ t(ctx, "editor.versions.version", uitext.Args{"Number": v.Number}) }</strong>
						<span class="muted">{ v.PublishedAt }</span>
						if v.PublishedBy != "" {
							<span class="muted">{ t(ctx, "editor.versions.by", uitext.Args{"Who": v.PublishedBy}) }</span>
						}
					</li>
				}
			</ul>
			<p class="muted">{ t(ctx, "editor.versions.immutable") }</p>
			<p><a href={ templ.SafeURL("/surveys/" + survey.ID + "/audit") }>{ t(ctx, "editor.versions.audit.label") }</a></p>
		</section>
	}
}

templ settingsPanel(csrf string, survey SurveyView) {
	<section class="card js-panel">
		<h2>{ t(ctx, "editor.settings.heading") }</h2>
		<form method="post" action={ templ.SafeURL("/surveys/" + survey.ID + "/settings") }>
			<input type="hidden" name="_csrf" value={ csrf }/>
			<label class="field">
				<span>{ t(ctx, "survey.name.label") }</span>
				<input type="text" name="title" value={ survey.Title } required maxlength="200" autocomplete="off" data-1p-ignore data-lpignore="true" data-bwignore/>
			</label>
			<label class="field">
				<span>
					@thtml(ctx, "editor.settings.close_date_html")
				</span>
				<input type="date" name="close_at" value={ survey.CloseAtInput } autocomplete="off"/>
			</label>
			<button type="submit" class="secondary">{ t(ctx, "editor.settings.save.label") }</button>
		</form>
		<p class="muted">
			if survey.IsAnonymous {
				{ t(ctx, "editor.settings.anonymous") }
			} else {
				{ t(ctx, "editor.settings.invited") }
			}
		</p>
		<form method="post" action={ templ.SafeURL("/surveys/" + survey.ID + "/delete") } class="danger-zone">
			<input type="hidden" name="_csrf" value={ csrf }/>
			<button type="submit" class="secondary danger">{ t(ctx, "editor.settings.delete.label") }</button>
			<span class="muted">{ t(ctx, "editor.settings.delete.hint") }</span>
		</form>
	</section>
}

templ SurveyAudit(email string, workspaceName string, csrf string, data SurveyAuditData) {
	@Layout(t(ctx, "audit.title", uitext.Args{"Survey": data.Survey.Title})) {
		@AuthedHeader(email, csrf)
		<main>
			<nav class="breadcrumb" aria-label={ t(ctx, "breadcrumb.aria") }>
				<a href="/surveys">{ t(ctx, "breadcrumb.surveys") }</a> /
				<a href={ templ.SafeURL("/surveys/" + data.Survey.ID) }>{ data.Survey.Title }</a> / { t(ctx, "audit.heading") }
			</nav>
			<h1>{ t(ctx, "audit.heading") }</h1>
			<p class="muted">{ t(ctx, "audit.intro") }</p>
			if len(data.Entries) == 0 {
				<p class="muted">{ t(ctx, "audit.empty") }</p>
			} else {
				<ol class="audit">
					for _, e := range data.Entries {
						<li>
							if e.Publish {
								<strong>{ e.What }</strong>
							} else {
								{ e.What }
							}
							<span class="muted">· { e.Who }, { e.When }</span>
						</li>
					}
				</ol>
			}
		</main>
	}
}

// surveyTabs are the views of one survey: its questions, its results,
// its stats and its languages. Results and stats exist once it is
// published.
templ surveyTabs(survey SurveyView, current string) {
	<nav class="tabs" aria-label={ t(ctx, "tabs.aria") }>
		<a href={ templ.SafeURL("/surveys/" + survey.ID) } if current == "questions" {
	aria-current="page"
}>{ t(ctx, "tabs.questions") }</a>
		if survey.LatestVersion > 0 {
			<a href={ templ.SafeURL("/surveys/" + survey.ID + "/results") } if current == "results" {
	aria-current="page"
}>{ t(ctx, "tabs.answers") }</a>
			<a href={ templ.SafeURL("/surveys/" + survey.ID + "/stats") } if current == "stats" {
	aria-current="page"
}>{ t(ctx, "tabs.stats") }</a>
		}
		<a href={ templ.SafeURL("/surveys/" + survey.ID + "/localizations") } if current == "languages" {
	aria-current="page"
}>{ t(ctx, "tabs.languages") }</a>
	</nav>
}
