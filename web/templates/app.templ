package templates

import (
	"strconv"

	"github.com/TryEarful/earful/internal/uitext"
)

// AuthedHeader is the shared chrome for signed in pages: the mark, the
// navigation, and the sign out button (a real POST form carrying the
// CSRF token, so that no GET anywhere changes state).
templ AuthedHeader(email string, csrf string) {
	<header class="site-header js-site-header">
		@lockup("/dashboard")
		<nav aria-label={ t(ctx, "header.nav.aria") }>
			<a
				href="/dashboard"
				if currentPath(ctx) == "/dashboard" {
					aria-current="page"
				}
			>{ t(ctx, "header.dashboard.label") }</a>
			<a
				href="/help"
				if currentPath(ctx) == "/help" {
					aria-current="page"
				}
			>{ t(ctx, "header.help.label") }</a>
			<a
				href="/account"
				title={ email }
				if accountCurrent(ctx) != "" {
					aria-current={ accountCurrent(ctx) }
				}
			>{ t(ctx, "header.account.label") }</a>
			<form method="post" action="/logout">
				<input type="hidden" name="_csrf" value={ csrf }/>
				<button type="submit" class="button-link">{ t(ctx, "header.sign_out.label") }</button>
			</form>
		</nav>
	</header>
	@suspensionNotice()
}

// suspensionNotice stands under the header on every page of a workspace
// an operator has suspended (ADR-0018): what is held, what is not, and
// whom to ask.
templ suspensionNotice() {
	if suspended, contact := suspension(ctx); suspended {
		<p class="notice suspension-notice js-suspension-notice" role="status">
			{ t(ctx, "suspension.notice") }
			if contact != "" {
				{ sentenceGap }
				{ t(ctx, "suspension.contact", uitext.Args{"Contact": contact}) }
			}
		</p>
	}
}

// WorkspaceSuspended answers an action a suspended workspace may not
// take: publishing, reopening, or sending invitations. refused says which
// was not done, back is the page the creator came from, and contact is
// whom to ask, or "" when the instance publishes nobody.
templ WorkspaceSuspended(email string, csrf string, back string, refused string, contact string) {
	@Layout(t(ctx, "suspension.held.title")) {
		@AuthedHeader(email, csrf)
		<main class="standalone js-suspension-held">
			<h1>{ t(ctx, "suspension.held.heading") }</h1>
			<p>
				// templ puts a space after text that a line break follows,
				// which is what separates the two sentences.
				{ refused }
				{ t(ctx, "suspension.held.body") }
			</p>
			if contact != "" {
				<p>{ t(ctx, "suspension.contact", uitext.Args{"Contact": contact}) }</p>
			}
			<p class="button-row"><a class="button-link" href={ templ.SafeURL(back) }>{ t(ctx, "suspension.held.back") }</a></p>
		</main>
	}
}

templ Dashboard(email string, workspaceName string, csrf string, data SurveyListData) {
	@Layout(t(ctx, "dashboard.title")) {
		@AuthedHeader(email, csrf)
		<main>
			<div class="title-row">
				<h1>{ t(ctx, "dashboard.heading") }</h1>
				<a class="button" href="/surveys/new">{ t(ctx, "dashboard.new.label") }</a>
			</div>
			<p class="muted workspace-name">{ workspaceName }</p>
			if len(data.Surveys) == 0 {
				<div class="card empty-state js-panel">
					@owl(OwlNeutral, 96)
					<h2>{ t(ctx, "dashboard.empty.heading") }</h2>
					<p>{ t(ctx, "dashboard.empty.body") }</p>
					<a class="button" href="/surveys/new">{ t(ctx, "dashboard.new.label") }</a>
				</div>
			} else {
				<ul class="survey-list">
					for i, s := range data.Surveys {
						<li class={ "card", "survey-card", "voice-" + strconv.Itoa(CardVoices(data.Surveys)[i]), "js-survey-card" }>
							<div class="title-row">
								<a class="survey-title" href={ templ.SafeURL("/surveys/" + s.ID) }>{ s.Title }</a>
								@StatusChip(s.Status)
							</div>
							<p class="muted">
								if s.IsAnonymous {
									{ t(ctx, "dashboard.survey.anonymous") }
								} else {
									{ t(ctx, "dashboard.survey.invited") }
								}
								if s.Published() {
									{ tn(ctx, "dashboard.survey.published", s.QuestionCount, uitext.Args{"Version": s.LatestVersion}) }
								} else {
									{ t(ctx, "dashboard.survey.unpublished") }
								}
								if s.CloseAtLabel != "" {
									{ t(ctx, "dashboard.survey.closes", uitext.Args{"Date": s.CloseAtLabel}) }
								}
							</p>
							if s.StarterNote {
								<p class="muted">{ t(ctx, "dashboard.survey.starter") }</p>
							}
						</li>
					}
				</ul>
			}
		</main>
	}
}

// workspaceExport is the "leave anytime" promise as a button (M7-T3).
// It is on the account page rather than hidden in settings because the
// point of it is that it is easy to find.
templ workspaceExport(csrf string, export ExportView) {
	<div class="card js-panel">
		<h2>{ t(ctx, "account.export.heading") }</h2>
		<p>
			{ t(ctx, "account.export.body") }
		</p>
		if export.Building {
			<p class="notice" role="status">
				{ t(ctx, "account.export.building") }
			</p>
		} else if export.Ready {
			<p class="notice">
				{ t(ctx, "account.export.ready", uitext.Args{"Size": export.SizeLabel, "Built": export.FinishedAt, "Expires": export.ExpiresAt}) }
			</p>
			<p><a class="button" href={ templ.SafeURL(export.DownloadPath) } download>{ t(ctx, "account.export.download.label") }</a></p>
		} else if export.Failed && export.Error != "" {
			<p class="notice error-text" role="alert">{ export.Error }</p>
		}
		<form method="post" action="/account/export">
			<input type="hidden" name="_csrf" value={ csrf }/>
			<button type="submit" class="secondary">
				if export.Ready {
					{ t(ctx, "account.export.again.label") }
				} else {
					{ t(ctx, "account.export.submit.label") }
				}
			</button>
		</form>
		<p class="muted">
			@thtml(ctx, "account.export.selfhost_html")
		</p>
	</div>
}

templ Account(email string, workspaceName string, csrf string, data AccountData) {
	@Layout(t(ctx, "account.title")) {
		@AuthedHeader(email, csrf)
		<main>
			<h1>{ t(ctx, "account.heading") }</h1>
			<div class="card js-panel">
				<dl class="facts">
					<dt>{ t(ctx, "account.facts.email") }</dt>
					<dd>{ email }</dd>
					if data.AIUsage != "" {
						<dt>{ t(ctx, "account.facts.ai") }</dt>
						<dd class="js-ai-usage">{ data.AIUsage }</dd>
					}
				</dl>
				if data.IsSuperAdmin {
					<p class="button-row">
						<a class="button-link" href="/admin/beta-codes">{ t(ctx, "account.admin.beta.label") }</a>
						<a class="button-link" href="/admin/metrics">{ t(ctx, "account.admin.metrics.label") }</a>
						<a class="button-link" href="/admin/erasure">{ t(ctx, "account.admin.erasure.label") }</a>
						<a class="button-link" href="/admin/ai-tiers">{ t(ctx, "account.admin.tiers.label") }</a>
						<a class="button-link" href="/admin/suspensions">{ t(ctx, "account.admin.suspensions.label") }</a>
					</p>
				}
			</div>
			if data.HasPassword {
				<div class="card js-panel">
					<h2>{ t(ctx, "account.email.heading") }</h2>
					if data.EmailNotice != "" {
						<p class="notice">{ data.EmailNotice }</p>
					}
					<form method="post" action="/account/email">
						<input type="hidden" name="_csrf" value={ csrf }/>
						<label class="field">
							<span>{ t(ctx, "account.email.new.label") }</span>
							<input type="email" name="email" required autocomplete="email"/>
						</label>
						<label class="field">
							<span>{ t(ctx, "account.email.password.label") }</span>
							<input type="password" name="password" required autocomplete="current-password"/>
						</label>
						if data.EmailError != "" {
							<p class="error-text">{ data.EmailError }</p>
						}
						<button type="submit">{ t(ctx, "account.email.submit.label") }</button>
					</form>
					<p class="muted">{ t(ctx, "account.email.hint") }</p>
				</div>
			}
			<div class="card js-panel">
				<h2>{ t(ctx, "account.workspace.heading") }</h2>
				if data.WorkspaceNotice != "" {
					<p class="notice" role="status">{ data.WorkspaceNotice }</p>
				}
				<form method="post" action="/account/workspace">
					<input type="hidden" name="_csrf" value={ csrf }/>
					<label class="field">
						<span>{ t(ctx, "account.workspace.label") }</span>
						<input type="text" name="name" required maxlength="80" value={ workspaceName }/>
						<small>{ t(ctx, "account.workspace.hint") }</small>
					</label>
					if data.WorkspaceError != "" {
						<p class="error-text">{ data.WorkspaceError }</p>
					}
					<button type="submit" class="secondary">{ t(ctx, "account.workspace.submit") }</button>
				</form>
			</div>
			<div class="card js-panel js-account-style-card">
				<h2>{ t(ctx, "account.style.card.heading") }</h2>
				if data.Style.IsZero() {
					<p>{ t(ctx, "account.style.card.none") }</p>
				} else {
					<p>{ t(ctx, "account.style.card.summary", uitext.Args{"Theme": t(ctx, themeName(data.Style.ThemeName())), "Header": !data.Style.Header.IsZero(), "Footer": !data.Style.Footer.IsZero()}) }</p>
				}
				<p class="button-row">
					<a class="button secondary js-account-style-edit" href="/account/style">{ t(ctx, "account.style.card.edit") }</a>
					if data.StyleHasWords {
						<a class="button secondary" href="/account/style/languages">{ t(ctx, "account.style.languages.link") }</a>
					}
				</p>
			</div>
			@workspaceExport(csrf, data.Export)
			<div class="card js-panel">
				<h2>{ t(ctx, "account.delete.heading") }</h2>
				<p>{ t(ctx, "account.delete.body") }</p>
				<form method="post" action="/account/delete">
					<input type="hidden" name="_csrf" value={ csrf }/>
					<label class="checkbox">
						<input type="checkbox" name="send_copy" value="yes" class="js-delete-send-copy" aria-describedby="delete-copy-hint"/>
						<span>{ t(ctx, "account.delete.copy.label") }</span>
					</label>
					<p class="muted" id="delete-copy-hint">{ t(ctx, "account.delete.copy.hint") }</p>
					<button type="submit" class="secondary danger">{ t(ctx, "account.delete.submit.label") }</button>
				</form>
			</div>
		</main>
	}
}
