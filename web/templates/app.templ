package templates

import "github.com/TryEarful/earful/internal/uitext"

// AuthedHeader is the shared chrome for signed-in pages: brand, nav, and
// the sign-out button (a real POST form carrying the CSRF token — no
// state-changing GETs anywhere).
templ AuthedHeader(email string, csrf string) {
	<header class="site-header">
		<a class="brand" href="/dashboard">Earful</a>
		<nav aria-label={ t(ctx, "header.nav.aria") }>
			<a href="/dashboard">{ t(ctx, "header.dashboard.label") }</a>
			<a href="/account">{ t(ctx, "header.account.label") }</a>
			<span class="muted">{ email }</span>
			<form method="post" action="/logout">
				<input type="hidden" name="_csrf" value={ csrf }/>
				<button type="submit" class="button-link">{ t(ctx, "header.sign_out.label") }</button>
			</form>
		</nav>
	</header>
}

templ Dashboard(email string, workspaceName string, csrf string, data SurveyListData) {
	@Layout(t(ctx, "dashboard.title")) {
		@AuthedHeader(email, csrf)
		<main>
			<div class="title-row">
				<h1>{ workspaceName }</h1>
				<a class="button" href="/surveys/new">{ t(ctx, "dashboard.new.label") }</a>
			</div>
			if len(data.Surveys) == 0 {
				<div class="card">
					<h2>{ t(ctx, "dashboard.empty.heading") }</h2>
					<p>{ t(ctx, "dashboard.empty.body") }</p>
					<p><a class="button" href="/surveys/new">{ t(ctx, "dashboard.new.label") }</a></p>
				</div>
			} else {
				<ul class="survey-list">
					for _, s := range data.Surveys {
						<li class="card">
							<div class="title-row">
								<a class="survey-title" href={ templ.SafeURL("/surveys/" + s.ID) }>{ s.Title }</a>
								@StatusChip(s.Status)
							</div>
							<p class="muted">
								if s.IsAnonymous {
									{ t(ctx, "dashboard.survey.anonymous") }
								} else {
									{ t(ctx, "dashboard.survey.invited") }
								}
								if s.Published() {
									{ tn(ctx, "dashboard.survey.published", s.QuestionCount, uitext.Args{"Version": s.LatestVersion}) }
								} else {
									{ t(ctx, "dashboard.survey.unpublished") }
								}
								if s.CloseAtLabel != "" {
									{ t(ctx, "dashboard.survey.closes", uitext.Args{"Date": s.CloseAtLabel}) }
								}
							</p>
							if s.StarterNote {
								<p class="muted">{ t(ctx, "dashboard.survey.starter") }</p>
							}
						</li>
					}
				</ul>
			}
		</main>
	}
}

// workspaceExport is the "leave anytime" promise as a button (M7-T3).
// It is on the account page rather than hidden in settings because the
// point of it is that it is easy to find.
templ workspaceExport(csrf string, export ExportView) {
	<div class="card">
		<h2>{ t(ctx, "account.export.heading") }</h2>
		<p>
			{ t(ctx, "account.export.body") }
		</p>
		if export.Building {
			<p class="notice" role="status">
				{ t(ctx, "account.export.building") }
			</p>
		} else if export.Ready {
			<p class="notice">
				{ t(ctx, "account.export.ready", uitext.Args{"Size": export.SizeLabel, "Built": export.FinishedAt, "Expires": export.ExpiresAt}) }
			</p>
			<p><a class="button" href={ templ.SafeURL(export.DownloadPath) } download>{ t(ctx, "account.export.download.label") }</a></p>
		} else if export.Failed && export.Error != "" {
			<p class="notice error-text">{ export.Error }</p>
		}
		<form method="post" action="/account/export">
			<input type="hidden" name="_csrf" value={ csrf }/>
			<button type="submit" class="secondary">
				if export.Ready {
					{ t(ctx, "account.export.again.label") }
				} else {
					{ t(ctx, "account.export.submit.label") }
				}
			</button>
		</form>
		<p class="muted">
			@thtml(ctx, "account.export.selfhost_html")
		</p>
	</div>
}

templ Account(email string, workspaceName string, csrf string, data AccountData) {
	@Layout(t(ctx, "account.title")) {
		@AuthedHeader(email, csrf)
		<main>
			<h1>{ t(ctx, "account.heading") }</h1>
			<div class="card">
				<p>
					@thtml(ctx, "account.signed_in_html", uitext.Args{"Email": email})
				</p>
				<p>
					@thtml(ctx, "account.workspace_html", uitext.Args{"Workspace": workspaceName})
				</p>
				if data.IsSuperAdmin {
					<p>
						<a href="/admin/beta-codes">{ t(ctx, "account.admin.beta.label") }</a> ·
						<a href="/admin/metrics">{ t(ctx, "account.admin.metrics.label") }</a> ·
						<a href="/admin/erasure">{ t(ctx, "account.admin.erasure.label") }</a>
					</p>
				}
			</div>
			<div class="card">
				<h2>{ t(ctx, "account.email.heading") }</h2>
				if data.EmailNotice != "" {
					<p class="notice">{ data.EmailNotice }</p>
				}
				<form method="post" action="/account/email">
					<input type="hidden" name="_csrf" value={ csrf }/>
					<label class="field">
						<span>{ t(ctx, "account.email.new.label") }</span>
						<input type="email" name="email" required autocomplete="email"/>
					</label>
					<label class="field">
						<span>{ t(ctx, "account.email.password.label") }</span>
						<input type="password" name="password" required autocomplete="current-password"/>
					</label>
					if data.EmailError != "" {
						<p class="error-text">{ data.EmailError }</p>
					}
					<button type="submit">{ t(ctx, "account.email.submit.label") }</button>
				</form>
				<p class="muted">{ t(ctx, "account.email.hint") }</p>
			</div>
			@workspaceExport(csrf, data.Export)
			<div class="card">
				<h2>{ t(ctx, "account.delete.heading") }</h2>
				<p>{ t(ctx, "account.delete.body") }</p>
				<form method="post" action="/account/delete">
					<input type="hidden" name="_csrf" value={ csrf }/>
					<button type="submit" class="danger">{ t(ctx, "account.delete.submit.label") }</button>
				</form>
			</div>
		</main>
	}
}
