package templates

import (
	"strconv"

	"github.com/TryEarful/earful/internal/uitext"
	"github.com/TryEarful/earful/web/static"
)

// SurveyResults is the creator's read of a survey (M7-T1). Results are
// aggregated by Question Identity across every version, so rewording a
// question keeps its answers together — and where the wording changed,
// the page says so instead of pretending it didn't.
templ SurveyResults(email string, workspaceName string, csrf string, data SurveyResultsData) {
	@Layout(t(ctx, "results.title", uitext.Args{"Survey": data.Survey.Title})) {
		@AuthedHeader(email, csrf)
		<main>
			<nav class="breadcrumb" aria-label={ t(ctx, "breadcrumb.aria") }>
				<a href="/surveys">{ t(ctx, "breadcrumb.surveys") }</a> /
				<a href={ templ.SafeURL("/surveys/" + data.Survey.ID) }>{ data.Survey.Title }</a> /
				{ t(ctx, "results.heading") }
			</nav>
			<div class="title-row">
				<h1>{ t(ctx, "results.heading") }</h1>
				@StatusChip(data.Survey.Status)
			</div>
			<nav class="tabs" aria-label={ t(ctx, "tabs.aria") }>
				<a href={ templ.SafeURL("/surveys/" + data.Survey.ID + "/results") } aria-current="page">{ t(ctx, "tabs.answers") }</a>
				<a href={ templ.SafeURL("/surveys/" + data.Survey.ID + "/stats") }>{ t(ctx, "tabs.stats") }</a>
			</nav>
			<p class="muted">
				{ responseCountLabel(ctx, data.ResponseCount) }
				if data.Survey.LatestVersion > 0 {
					{ " " + tn(ctx, "results.versions", data.Survey.LatestVersion) }
				}
			</p>
			if data.Notice != "" {
				<p class="notice" role="status">{ data.Notice }</p>
			}
			<div class="results-actions">
				<a class="button secondary" href={ templ.SafeURL("/surveys/" + data.Survey.ID + "/results.csv") }>
					{ t(ctx, "results.csv.label") }
				</a>
				if data.CanTranslate {
					@translateForm(csrf, data)
				}
			</div>

			@insightPanel(csrf, data)

			if data.ResponseCount == 0 {
				<section class="card">
					<h2>{ t(ctx, "results.empty.heading") }</h2>
					<p class="muted">
						{ t(ctx, "results.empty.body") }
					</p>
				</section>
			} else {
				for _, q := range data.Questions {
					@questionResults(q)
				}
				@responseTable(csrf, data)
			}
		</main>
		if data.Insight.Available {
			<script src={ static.AssetURL("js/wsclient.js") } defer></script>
			<script src={ static.AssetURL("js/insights.js") } defer></script>
		}
	}
}

// insightPanel is the Insight Summary (M10-T2). Everything about it says
// "this was written by a model": the heading, the label with the model
// and the time, and a warning when responses have arrived since. It is
// never rendered as though it were data.
templ insightPanel(csrf string, data SurveyResultsData) {
	if data.Insight.Available && data.ResponseCount > 0 {
		<section class="card insight" id="insights" data-insight-path={ "/surveys/" + data.Survey.ID + "/insights/stream" }>
			<h2>{ t(ctx, "results.insight.heading") }</h2>
			if data.Insight.Present {
				<p class="ai-label">
					@thtml(ctx, "results.insight.label_html", uitext.Args{"Model": data.Insight.Model, "Date": data.Insight.GeneratedAt, "Responses": data.Insight.CountLabel})
				</p>
				if data.Insight.Stale {
					<p class="notice">{ data.Insight.StaleNote } { t(ctx, "results.insight.again_hint") }</p>
				}
				<pre class="insight-output">{ data.Insight.Output }</pre>
			} else {
				<p class="muted">
					{ t(ctx, "results.insight.intro") }
				</p>
				<pre class="insight-output" hidden></pre>
			}
			<form method="post" action={ templ.SafeURL("/surveys/" + data.Survey.ID + "/insights") } class="insight-form">
				<input type="hidden" name="_csrf" value={ csrf }/>
				<button type="submit" class="secondary">
					if data.Insight.Present {
						{ t(ctx, "results.insight.again.label") }
					} else {
						{ t(ctx, "results.insight.run.label") }
					}
				</button>
			</form>
		</section>
	}
}

// responseTable is the raw view (story 58) and the only place a
// response can be deleted: deleting is per response, not per answer,
// because a response is what a person submitted.
templ responseTable(csrf string, data SurveyResultsData) {
	<section class="card">
		<details>
			<summary><h2>{ t(ctx, "results.table.heading") }</h2></summary>
			<div class="table-scroll">
				<table class="responses">
					<thead>
						<tr>
							for _, header := range data.TableHeaders {
								<th scope="col">{ header }</th>
							}
							if !data.Survey.IsAnonymous {
								<th scope="col">{ t(ctx, "results.table.participant") }</th>
							}
							<th scope="col"><span class="visually-hidden">{ t(ctx, "results.table.actions") }</span></th>
						</tr>
					</thead>
					<tbody>
						for _, row := range data.Table {
							<tr>
								<td>{ row.SubmittedAt }</td>
								<td><span class="chip chip-small">{ row.VersionLabel }</span></td>
								for _, cell := range row.Cells {
									<td>{ cell }</td>
								}
								if !data.Survey.IsAnonymous {
									<td>{ row.Participant }</td>
								}
								<td>
									<form method="post" action={ templ.SafeURL("/surveys/" + data.Survey.ID + "/responses/" + row.ID + "/delete") }>
										<input type="hidden" name="_csrf" value={ csrf }/>
										<button type="submit" class="button-link danger">{ t(ctx, "results.table.delete.label") }</button>
									</form>
								</td>
							</tr>
						}
					</tbody>
				</table>
			</div>
			<p class="muted">
				{ t(ctx, "results.table.note") }
			</p>
		</details>
	</section>
}

// translateForm is M11-T2's entrance: translate the written answers into
// a language you read. Originals are never replaced.
templ translateForm(csrf string, data SurveyResultsData) {
	<form method="post" action={ templ.SafeURL("/surveys/" + data.Survey.ID + "/answers/translate") } class="translate-form">
		<input type="hidden" name="_csrf" value={ csrf }/>
		<label class="field">
			<span>{ t(ctx, "results.translate.label") }</span>
			<input type="text" name="lang" maxlength="8" placeholder={ t(ctx, "results.translate.placeholder") } value={ data.TranslateLang } required/>
		</label>
		<button type="submit" class="secondary">{ t(ctx, "results.translate.submit.label") }</button>
	</form>
	if data.TranslateLang != "" {
		<p class="muted">
			{ t(ctx, "results.translate.showing", uitext.Args{"Language": data.TranslateName}) }
			<a href={ templ.SafeURL("/surveys/" + data.Survey.ID + "/results") }>{ t(ctx, "results.translate.originals.label") }</a>
		</p>
	}
}

templ questionResults(q QuestionResultsView) {
	<section class="card result">
		<h2>{ q.Text }</h2>
		<p class="muted">
			{ q.TypeLabel } · { tn(ctx, "results.answers", q.Answered) }
			if q.SkippedNote != "" {
				{ " · " + q.SkippedNote }
			}
		</p>
		if len(q.Wordings) > 0 {
			<details class="wordings">
				<summary>{ t(ctx, "results.question.reworded") }</summary>
				<ul>
					for _, w := range q.Wordings {
						<li><span class="chip chip-small">{ w.Label }</span> { w.Text }</li>
					}
				</ul>
				<p class="muted">
					{ t(ctx, "results.question.together") }
				</p>
			</details>
		}
		if q.Summary != "" {
			<p class="result-summary">{ q.Summary }</p>
		}
		if len(q.Distribution) > 0 {
			<ul class="distribution">
				for _, row := range q.Distribution {
					<li>
						<span class="bar-label">{ row.Label }</span>
						<svg class="bar" aria-hidden="true" focusable="false">
							<rect class="bar-fill" width={ barWidth(row.Percent) } height="100%"></rect>
						</svg>
						<span class="bar-count">{ strconv.Itoa(row.Count) } ({ row.Share })</span>
					</li>
				}
			</ul>
		}
		if len(q.Texts) > 0 {
			<ol class="transcripts">
				for _, answer := range q.Texts {
					<li>
						<p class="transcript-text">{ answer.Text }</p>
						if answer.Translation != "" {
							<p class="transcript-translation">
								<span class="chip chip-small">{ t(ctx, "results.answer.machine") }</span>
								{ answer.Translation }
							</p>
							<p class="muted transcript-meta">{ t(ctx, "results.answer.translated_by", uitext.Args{"Model": answer.TranslationModel}) }</p>
						}
						<p class="muted transcript-meta">
							{ answer.SubmittedAt } · <span class="chip chip-small">{ answer.VersionLabel }</span>
							if answer.Participant != "" {
								{ " · " + answer.Participant }
							}
						</p>
					</li>
				}
			</ol>
		}
		if len(q.Distribution) == 0 && len(q.Texts) == 0 {
			<p class="muted">{ t(ctx, "results.question.empty") }</p>
		}
	</section>
}

// barWidth is the width attribute of a distribution bar's SVG rect. The
// percentage is data, and the CSP (style-src 'self', no 'unsafe-inline')
// governs style attributes exactly as it governs <style> elements, so an
// inline style would be dropped and every bar would fill its track. An
// SVG presentation attribute is markup rather than a stylesheet and needs
// no CSP exception; the percentage resolves against the svg's own box
// because the element carries no viewBox.
func barWidth(percent int) string {
	if percent < 2 && percent > 0 {
		percent = 2 // keep a non-zero result visible
	}
	return strconv.Itoa(percent) + "%"
}
