package templates

import "strconv"

// OwlMood is which face the owl makes. Each has one kind of moment, and
// docs/style-guide.md lists where each appears and where the owl never
// does: next to data, charts, admin tools and failures that cost someone
// something.
type OwlMood string

const (
	// OwlNeutral is the mark itself: the header, the sign in pages, an
	// empty dashboard.
	OwlNeutral OwlMood = "neutral"
	// OwlListening is drawn while someone is speaking an answer.
	OwlListening OwlMood = "listening"
	// OwlHappy is drawn when something is done: answers sent, a survey
	// published.
	OwlHappy OwlMood = "happy"
	// OwlSurprised is drawn when a link leads nowhere.
	OwlSurprised OwlMood = "surprised"
)

// owl draws the mark inline rather than as an image. The Content Security
// Policy (style-src 'self') keeps an SVG file from carrying rules of its
// own, so an <img> could not change colour with the page's theme; inline,
// every part is filled by a class the stylesheet colours. It is
// decoration: whatever it stands beside says what it means.
//
// size is the height in pixels. The listening owl is wider, to make room
// for the sound it hears.
templ owl(mood OwlMood, size int) {
	<svg
		class={ "owl", "owl-" + string(mood) }
		viewBox={ owlViewBox(mood) }
		width={ strconv.Itoa(owlWidth(mood, size)) }
		height={ strconv.Itoa(size) }
		aria-hidden="true"
		focusable="false"
	>
		<path class="owl-accent" d="M25 21C22.5 18.5 21.5 16 21.5 13.5C26 14 31.5 16 36 19Z"></path>
		<path class="owl-accent" d="M71 21C73.5 18.5 74.5 16 74.5 13.5C70 14 64.5 16 60 19Z"></path>
		<circle class="owl-body" cx="48" cy="52" r="40"></circle>
		<path class="owl-accent" d="M13 58C20 67 30 73 33 89.1A40 40 0 0 1 9.5 62C10.5 60 11.7 58.8 13 58Z"></path>
		<path class="owl-accent" d="M83 58C76 67 66 73 63 89.1A40 40 0 0 0 86.5 62C85.5 60 84.3 58.8 83 58Z"></path>
		<path class="owl-face" d="M48 38C43 28 31 24 23 29C15 35 14 47 18 55C24 64 35 70 38 90.6A40 40 0 0 0 58 90.6C61 70 72 64 78 55C82 47 81 35 73 29C65 24 53 28 48 38Z"></path>
		switch mood {
			case OwlHappy:
				<path class="owl-lid" d="M28 48Q35 39 42 48"></path>
				<path class="owl-lid" d="M54 48Q61 39 68 48"></path>
			default:
				<circle class="owl-accent" cx="35" cy="46" r="9.5"></circle>
				<circle class="owl-accent" cx="61" cy="46" r="9.5"></circle>
				<circle class="owl-eye" cx="35" cy="46" r="6.8"></circle>
				<circle class="owl-eye" cx="61" cy="46" r="6.8"></circle>
				<circle class="owl-glint" cx="37.4" cy="43.4" r="2"></circle>
				<circle class="owl-glint" cx="63.4" cy="43.4" r="2"></circle>
		}
		<circle class="owl-rim" cx="48" cy="52" r="40"></circle>
		<path class="owl-beak" d="M44 56Q48 54.2 52 56L48.9 63Q48 64.6 47.1 63Z"></path>
		if mood == OwlSurprised {
			<circle class="owl-mouth" cx="48" cy="71" r="2.6"></circle>
		}
		if mood == OwlListening {
			<path class="owl-wave" d="M93 45Q97 52 93 59"></path>
			<path class="owl-wave" d="M99 40Q105 52 99 64"></path>
			<path class="owl-wave" d="M105 35Q113 52 105 69"></path>
		}
	</svg>
}

func owlViewBox(mood OwlMood) string {
	if mood == OwlListening {
		return "0 0 114 96"
	}
	return "0 0 96 96"
}

func owlWidth(mood OwlMood, size int) int {
	if mood == OwlListening {
		return size * 114 / 96
	}
	return size
}

// lockup is the owl beside the wordmark, as a link. The wordmark is the
// link's name; the owl beside it is decoration.
templ lockup(href string) {
	<a class="brand" href={ templ.SafeURL(href) }>
		@owl(OwlNeutral, 30)
		<span class="wordmark">earful</span>
	</a>
}
