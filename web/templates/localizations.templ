package templates

import "github.com/TryEarful/earful/internal/uitext"

// Localizations is the translation workspace (M11-T1). Every translation
// sits beside the question it translates, because reviewing means
// comparing — and the page never lets a language look publishable until
// a person has actually read every line.
templ Localizations(email string, workspaceName string, csrf string, data LocalizationsData) {
	@Layout(t(ctx, "languages.title", uitext.Args{"Survey": data.Survey.Title})) {
		@AuthedHeader(email, csrf)
		<main>
			<nav class="breadcrumb" aria-label={ t(ctx, "breadcrumb.aria") }>
				<a href="/surveys">{ t(ctx, "breadcrumb.surveys") }</a> /
				<a href={ templ.SafeURL("/surveys/" + data.Survey.ID) }>{ data.Survey.Title }</a> /
				{ t(ctx, "languages.heading") }
			</nav>
			<h1>{ t(ctx, "languages.heading") }</h1>
			@surveyTabs(data.Survey, "languages")
			<p class="muted">
				{ t(ctx, "languages.intro") }
			</p>
			if data.Error != "" {
				<p class="notice error-text" role="alert">{ data.Error }</p>
			}
			if data.Notice != "" {
				<p class="notice" role="status">{ data.Notice }</p>
			}
			<section class="card js-panel">
				<h2>{ t(ctx, "languages.add.heading") }</h2>
				<form method="post" action={ templ.SafeURL("/surveys/" + data.Survey.ID + "/localizations") }>
					<input type="hidden" name="_csrf" value={ csrf }/>
					<label class="field">
						<span>
							@thtml(ctx, "languages.add.code.label_html")
						</span>
						<input type="text" name="lang" required maxlength="8" placeholder={ t(ctx, "languages.add.code.placeholder") } autocomplete="off" data-1p-ignore data-lpignore="true" data-bwignore/>
					</label>
					<button type="submit" class={ templ.KV("secondary", len(data.Languages) > 0) }>{ t(ctx, "languages.add.submit.label") }</button>
				</form>
				if len(data.Questions) == 0 {
					<p class="muted">{ t(ctx, "languages.add.empty") }</p>
				}
			</section>
			for _, lang := range data.Languages {
				@languagePanel(csrf, data, lang)
			}
		</main>
	}
}

// The translation fields opt out of autocomplete and password managers
// for the same reason as the editor's (see NewSurvey).
templ languagePanel(csrf string, data LocalizationsData, lang LanguageView) {
	<section class="card js-panel" id={ "lang-" + lang.Code }>
		<div class="title-row">
			<h2>{ lang.Label } <span class="muted">({ lang.Code })</span></h2>
			if lang.Ready {
				<span class="chip chip-open">{ t(ctx, "languages.status.reviewed") }</span>
			} else {
				<span class="chip chip-draft">{ t(ctx, "languages.status.pending", uitext.Args{"Count": lang.PendingCount}) }</span>
			}
		</div>
		<p class="muted">{ t(ctx, "languages.status.progress", uitext.Args{"Reviewed": lang.Reviewed, "Total": lang.Total, "Blocked": !lang.Ready}) }</p>
		<div class="button-row">
			if data.CanTranslate && !lang.Ready {
				<form method="post" action={ templ.SafeURL("/surveys/" + data.Survey.ID + "/localizations/" + lang.Code + "/draft") }>
					<input type="hidden" name="_csrf" value={ csrf }/>
					<button type="submit" class="secondary">{ t(ctx, "languages.draft.label") }</button>
				</form>
			}
			<form method="post" action={ templ.SafeURL("/surveys/" + data.Survey.ID + "/localizations/" + lang.Code + "/delete") }>
				<input type="hidden" name="_csrf" value={ csrf }/>
				<button type="submit" class="button-link danger">{ t(ctx, "languages.remove.label", uitext.Args{"Language": lang.Name}) }</button>
			</form>
		</div>
		<form method="post" action={ templ.SafeURL("/surveys/" + data.Survey.ID + "/localizations/" + lang.Code) }>
			<input type="hidden" name="_csrf" value={ csrf }/>
			<ol class="translations">
				for _, q := range lang.Questions {
					<li>
						<p class="source-text">{ q.SourceText }</p>
						if q.Stale {
							<p class="notice">{ t(ctx, "languages.question.stale") }</p>
						} else if !q.Reviewed && q.Text != "" {
							<p class="muted">{ t(ctx, "languages.question.unreviewed") }</p>
						}
						<label class="field">
							<span>{ lang.Label }</span>
							<textarea name={ "t_" + q.IdentityID } autocomplete="off" data-1p-ignore data-lpignore="true" data-bwignore rows="2">{ q.Text }</textarea>
						</label>
						if q.NeedsOptions {
							<label class="field">
								<span>
									@thtml(ctx, "languages.options.label_html")
								</span>
								<textarea name={ "o_" + q.IdentityID } autocomplete="off" data-1p-ignore data-lpignore="true" data-bwignore rows="3" placeholder={ q.SourceOptions }>{ q.Options }</textarea>
							</label>
						}
					</li>
				}
			</ol>
			if lang.Thanks != nil {
				@thanksTranslation(lang)
			}
			if lang.Style != nil {
				@styleTranslation(lang)
			}
			if lang.AccountStyle != nil {
				@accountStyleRow(lang)
			}
			<button type="submit">{ t(ctx, "languages.save.label") }</button>
		</form>
	</section>
}

// thanksTranslation is the thank you page in one language, each part
// beside the creator's wording, reviewed like a question.
templ thanksTranslation(lang LanguageView) {
	<div class="js-thanks-translation">
		<h3>{ t(ctx, "languages.thanks.heading") }</h3>
		if lang.Thanks.Stale {
			<p class="notice">{ t(ctx, "languages.thanks.stale") }</p>
		} else if !lang.Thanks.Reviewed && lang.Thanks.Message != "" {
			<p class="muted">{ t(ctx, "languages.question.unreviewed") }</p>
		}
		if lang.Thanks.SourceMessage != "" {
			<p class="source-text">{ lang.Thanks.SourceMessage }</p>
			<label class="field">
				<span>{ t(ctx, "languages.thanks.message", uitext.Args{"Language": lang.Name}) }</span>
				<textarea name="thanks_message" autocomplete="off" data-1p-ignore data-lpignore="true" data-bwignore rows="4" maxlength="1000">{ lang.Thanks.Message }</textarea>
			</label>
		}
		if lang.Thanks.SourceLinkLabel != "" {
			<p class="source-text">{ lang.Thanks.SourceLinkLabel }</p>
			<label class="field">
				<span>{ t(ctx, "languages.thanks.link_label", uitext.Args{"Language": lang.Name}) }</span>
				<input type="text" name="thanks_link_label" value={ lang.Thanks.LinkLabel } maxlength="60" autocomplete="off" data-1p-ignore data-lpignore="true" data-bwignore/>
			</label>
		}
	</div>
}

// styleTranslation is the words of the survey's style in one language
// (ADR-0018), each beside the creator's wording, reviewed like a
// question. The name and the links' addresses are the same in every
// language and are not here.
templ styleTranslation(lang LanguageView) {
	<div class="js-style-translation">
		<h3>{ t(ctx, "languages.style.heading") }</h3>
		if lang.Style.Stale {
			<p class="notice">{ t(ctx, "languages.style.stale") }</p>
		} else if !lang.Style.Reviewed && !lang.Style.Words.IsZero() {
			<p class="muted">{ t(ctx, "languages.question.unreviewed") }</p>
		}
		@styleWordsFields(lang.Name, *lang.Style)
	</div>
}

// accountStyleRow is the words the survey shows from its account's style
// (ADR-0023). They are translated once, on the account, so here they are
// a state and a way there rather than fields.
templ accountStyleRow(lang LanguageView) {
	<div class="js-account-style-row">
		<h3>{ t(ctx, "languages.account_style.heading") }</h3>
		if lang.AccountStyle.Pending {
			<p class="muted">{ t(ctx, "languages.account_style.pending", uitext.Args{"Language": lang.Name}) }</p>
			<p><a class="button secondary js-account-style-translate" href={ templ.SafeURL("/account/style/languages#lang-" + lang.Code) }>{ t(ctx, "languages.account_style.link") }</a></p>
		} else {
			<p class="muted">{ t(ctx, "languages.account_style.ready", uitext.Args{"Language": lang.Name}) }</p>
		}
	</div>
}

// styleWordsFields are a style's words in one language, each beside the
// wording it is translated from, for a survey's Languages tab or an
// account's style (ADR-0023). language names the language, for the
// labels.
templ styleWordsFields(language string, style LocalizedStyleView) {
	if style.Source.Tagline != "" {
		<p class="source-text">{ style.Source.Tagline }</p>
		<label class="field">
			<span>{ t(ctx, "languages.style.tagline", uitext.Args{"Language": language}) }</span>
			<textarea name="style_tagline" autocomplete="off" data-1p-ignore data-lpignore="true" data-bwignore rows="3" maxlength="280">{ style.Words.Tagline }</textarea>
		</label>
	}
	if style.Source.LogoAlt != "" {
		<p class="source-text">{ style.Source.LogoAlt }</p>
		<label class="field">
			<span>{ t(ctx, "languages.style.logo_alt", uitext.Args{"Language": language}) }</span>
			<input type="text" name="style_logo_alt" value={ style.Words.LogoAlt } maxlength="120" autocomplete="off" data-1p-ignore data-lpignore="true" data-bwignore/>
		</label>
	}
	for i, source := range style.Source.HeaderLinks {
		<p class="source-text">{ source }</p>
		<label class="field">
			<span>{ t(ctx, "languages.style.header_link", uitext.Args{"Position": i + 1, "Language": language}) }</span>
			<input type="text" name="style_header_link" value={ label(style.Words.HeaderLinks, i) } maxlength="60" autocomplete="off" data-1p-ignore data-lpignore="true" data-bwignore/>
		</label>
	}
	if style.Source.FooterText != "" {
		<p class="source-text">{ style.Source.FooterText }</p>
		<label class="field">
			<span>{ t(ctx, "languages.style.footer_text", uitext.Args{"Language": language}) }</span>
			<textarea name="style_footer_text" autocomplete="off" data-1p-ignore data-lpignore="true" data-bwignore rows="3" maxlength="280">{ style.Words.FooterText }</textarea>
		</label>
	}
	for i, source := range style.Source.FooterLinks {
		<p class="source-text">{ source }</p>
		<label class="field">
			<span>{ t(ctx, "languages.style.footer_link", uitext.Args{"Position": i + 1, "Language": language}) }</span>
			<input type="text" name="style_footer_link" value={ label(style.Words.FooterLinks, i) } maxlength="60" autocomplete="off" data-1p-ignore data-lpignore="true" data-bwignore/>
		</label>
	}
	if style.Source.ThanksAlt != "" {
		<p class="source-text">{ style.Source.ThanksAlt }</p>
		<label class="field">
			<span>{ t(ctx, "languages.style.thanks_alt", uitext.Args{"Language": language}) }</span>
			<input type="text" name="style_thanks_alt" value={ style.Words.ThanksAlt } maxlength="120" autocomplete="off" data-1p-ignore data-lpignore="true" data-bwignore/>
		</label>
	}
}
