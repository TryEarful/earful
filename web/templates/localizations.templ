package templates

import "github.com/TryEarful/earful/internal/uitext"

// Localizations is the translation workspace (M11-T1). Every translation
// sits beside the question it translates, because reviewing means
// comparing — and the page never lets a language look publishable until
// a person has actually read every line.
templ Localizations(email string, workspaceName string, csrf string, data LocalizationsData) {
	@Layout(t(ctx, "languages.title", uitext.Args{"Survey": data.Survey.Title})) {
		@AuthedHeader(email, csrf)
		<main>
			<nav class="breadcrumb" aria-label={ t(ctx, "breadcrumb.aria") }>
				<a href="/surveys">{ t(ctx, "breadcrumb.surveys") }</a> /
				<a href={ templ.SafeURL("/surveys/" + data.Survey.ID) }>{ data.Survey.Title }</a> /
				{ t(ctx, "languages.heading") }
			</nav>
			<h1>{ t(ctx, "languages.heading") }</h1>
			<p class="muted">
				{ t(ctx, "languages.intro") }
			</p>

			if data.Error != "" {
				<p class="notice error-text">{ data.Error }</p>
			}
			if data.Notice != "" {
				<p class="notice" role="status">{ data.Notice }</p>
			}

			<section class="card">
				<h2>{ t(ctx, "languages.add.heading") }</h2>
				<form method="post" action={ templ.SafeURL("/surveys/" + data.Survey.ID + "/localizations") }>
					<input type="hidden" name="_csrf" value={ csrf }/>
					<label class="field">
						<span>
							@thtml(ctx, "languages.add.code.label_html")
						</span>
						<input type="text" name="lang" required maxlength="8" placeholder={ t(ctx, "languages.add.code.placeholder") }/>
					</label>
					<button type="submit">{ t(ctx, "languages.add.submit.label") }</button>
				</form>
				if len(data.Questions) == 0 {
					<p class="muted">{ t(ctx, "languages.add.empty") }</p>
				}
			</section>

			for _, lang := range data.Languages {
				@languagePanel(csrf, data, lang)
			}
		</main>
	}
}

templ languagePanel(csrf string, data LocalizationsData, lang LanguageView) {
	<section class="card" id={ "lang-" + lang.Code }>
		<div class="title-row">
			<h2>{ lang.Name } <span class="muted">({ lang.Code })</span></h2>
			if lang.Ready {
				<span class="chip chip-open">{ t(ctx, "languages.status.reviewed") }</span>
			} else {
				<span class="chip chip-draft">{ t(ctx, "languages.status.pending", uitext.Args{"Count": lang.PendingCount}) }</span>
			}
		</div>
		<p class="muted">{ t(ctx, "languages.status.progress", uitext.Args{"Reviewed": lang.Reviewed, "Total": lang.Total, "Blocked": !lang.Ready}) }</p>

		<div class="button-row">
			if data.CanTranslate {
				<form method="post" action={ templ.SafeURL("/surveys/" + data.Survey.ID + "/localizations/" + lang.Code + "/draft") }>
					<input type="hidden" name="_csrf" value={ csrf }/>
					<button type="submit" class="secondary">{ t(ctx, "languages.draft.label") }</button>
				</form>
			}
			<form method="post" action={ templ.SafeURL("/surveys/" + data.Survey.ID + "/localizations/" + lang.Code + "/delete") }>
				<input type="hidden" name="_csrf" value={ csrf }/>
				<button type="submit" class="button-link danger">{ t(ctx, "languages.remove.label", uitext.Args{"Language": lang.Name}) }</button>
			</form>
		</div>

		<form method="post" action={ templ.SafeURL("/surveys/" + data.Survey.ID + "/localizations/" + lang.Code) }>
			<input type="hidden" name="_csrf" value={ csrf }/>
			<ol class="translations">
				for _, q := range lang.Questions {
					<li>
						<p class="source-text">{ q.SourceText }</p>
						if q.Stale {
							<p class="notice">{ t(ctx, "languages.question.stale") }</p>
						} else if !q.Reviewed && q.Text != "" {
							<p class="muted">{ t(ctx, "languages.question.unreviewed") }</p>
						}
						<label class="field">
							<span>{ lang.Name }</span>
							<textarea name={ "t_" + q.IdentityID } rows="2">{ q.Text }</textarea>
						</label>
						if q.NeedsOptions {
							<label class="field">
								<span>
									@thtml(ctx, "languages.options.label_html")
								</span>
								<textarea name={ "o_" + q.IdentityID } rows="3" placeholder={ q.SourceOptions }>{ q.Options }</textarea>
							</label>
						}
					</li>
				}
			</ol>
			<button type="submit">{ t(ctx, "languages.save.label") }</button>
		</form>
	</section>
}
