package templates

import (
	"context"
	"net/url"
	"strconv"

	"github.com/TryEarful/earful/internal/domain"
	"github.com/TryEarful/earful/internal/uitext"
	"github.com/TryEarful/earful/web/static"
)

// RespondData is everything the respondent renderer needs. The same
// template serves live surveys and creator previews (M3-T6): Preview
// swaps the destination and banner, so what a creator reviews is
// literally what a respondent gets.
type RespondData struct {
	SurveyID      string
	Title         string
	WorkspaceName string
	IsAnonymous   bool
	VersionID     string
	Questions     []domain.Question
	// Answers holds submitted values when re-rendering after a validation
	// problem, so nobody retypes a long answer.
	Answers map[string]domain.AnswerValue
	// Errors is keyed by Question Identity.
	Errors map[string]string
	// ErrorList drives the summary at the top, which is what screen
	// reader and keyboard users reach first.
	ErrorList []domain.AnswerError
	// Notice is an informational banner ("that was quick — review and
	// resubmit"), distinct from validation errors.
	Notice  string
	Preview bool
	// PreviewAll shows a preview with every question on one page, as it
	// renders without a script, instead of one at a time; the creator
	// reads a long survey without stepping through it. PreviewLayoutLink
	// is the address of the other layout. Both mean nothing outside a
	// preview.
	PreviewAll        bool
	PreviewLayoutLink string
	// FormToken is the HMAC-signed render timestamp (antibot.FormTokens);
	// Nonce identifies this render for double-click dedupe.
	FormToken string
	Nonce     string
	// AlreadyAnswered shows the soft-dedupe note (story 43) when this
	// browser has answered before.
	AlreadyAnswered bool
	// ParticipantToken/ParticipantEmail switch the form onto the personal
	// invite link (M4-T3): the action posts back to /p/{token} and the
	// disclosure names the invitee.
	ParticipantToken string
	ParticipantEmail string
	// Lang is the language being served (empty for the original), and
	// Languages are the choices offered. The choice lives in the URL and
	// is stored nowhere (story 25).
	Lang      string
	Languages []LanguageChoice
	// VoicePath is the WebSocket endpoint for spoken answers, empty when
	// no transcription is configured (M5). The mic is built entirely by
	// voice.js: nothing about it is server-rendered, so a respondent
	// without JavaScript sees exactly the form they can actually use.
	VoicePath       string
	VoiceMaxSeconds int
	// CSRF is the creator's session token, set on a preview only: the
	// preview posts to a signed in route, which refuses a form without it.
	CSRF string
}

// VoiceEnabled reports whether this page offers spoken answers.
func (d RespondData) VoiceEnabled() bool { return d.VoicePath != "" && !d.Preview }

// RespondLayout is a self-contained page shell for respondent pages. It
// deliberately does not reuse the creator chrome: a respondent has no
// account, no navigation, and nothing to sign out of. Its footer holds
// only what a respondent may need before answering: help, what
// happens to their answers, and the theme to read them in. `noindex`
// keeps surveys out of search results and LLM scrapes (M4-T5).
templ RespondLayout(title string, lang string) {
	<!DOCTYPE html>
	<html
		lang={ htmlLang(ctx, lang) }
		if theme(ctx) != "" {
			data-theme={ theme(ctx) }
		}
	>
		<head>
			<meta charset="utf-8"/>
			<meta name="viewport" content="width=device-width, initial-scale=1"/>
			<meta name="robots" content="noindex, nofollow, noarchive"/>
			<title>{ title }</title>
			@headAssets()
		</head>
		<body class="respond">
			{ children... }
			<footer class="site-footer respond-footer">
				<span class="made-with">
					@owl(OwlNeutral, 20)
					Earful
				</span>
				@footerLinks(lang)
				<div class="switchers">
					@themeSwitcher()
				</div>
			</footer>
		</body>
	</html>
}

// htmlLang is what the page declares itself to be, which screen readers
// pick their pronunciation from. A respondent's page is for its
// questions, so it declares the language of the survey where one was
// chosen; where none was, and on a page that has no questions, it
// declares the language it is worded in.
func htmlLang(ctx context.Context, lang string) string {
	if lang == "" {
		return interfaceLang(ctx)
	}
	return lang
}

// sentenceGap is written between two sentences and is empty: what
// separates them is the space templ adds after it.
const sentenceGap = ""

// voiceLang is the language dictation listens for (M11-T3): the
// language of the questions, since a respondent answers in the language
// they are asked in, whatever language the buttons around the questions
// are in. Where the respondent chose a language for the survey, that is
// it. Where they are reading the survey as it was written, it is not
// known: nothing records what language a creator wrote in. Then it is
// empty, and whoever transcribes works out for themselves what was
// said, which a recogniser told the wrong language cannot do; it writes
// down something else.
//
// It is an attribute of its own and not read off the page's declaration,
// which is the language of the wording where the survey's is not known.
func voiceLang(lang string) string {
	return lang
}

templ Respond(data RespondData) {
	@RespondLayout(data.Title, data.Lang) {
		<main>
			if data.Preview {
				<div class="preview-banner" role="status">
					<p>
						if data.PreviewAll {
							@thtml(ctx, "respond.preview.banner_all_html")
						} else {
							@thtml(ctx, "respond.preview.banner_html")
						}
					</p>
					<a class="button secondary js-preview-layout" href={ templ.SafeURL(data.PreviewLayoutLink) }>
						if data.PreviewAll {
							{ t(ctx, "respond.preview.layout_paged") }
						} else {
							{ t(ctx, "respond.preview.layout_all") }
						}
					</a>
				</div>
			}
			<h1>{ data.Title }</h1>
			@languagePicker(data)
			@respondentDisclosure(data)
			if data.AlreadyAnswered && !data.Preview {
				<p class="notice">{ t(ctx, "respond.before.note") }</p>
			}
			if data.Notice != "" {
				<p class="notice" role="status">{ data.Notice }</p>
			}
			if len(data.ErrorList) > 0 {
				<div class="error-summary js-error-summary" role="alert" tabindex="-1" id="error-summary">
					<h2>{ tn(ctx, "respond.errors.heading", len(data.ErrorList)) }</h2>
					<ul>
						for _, e := range data.ErrorList {
							<li><a href={ templ.SafeURL("#q-" + e.IdentityID) }>{ t(ctx, "respond.errors.item", uitext.Args{"Position": e.Position, "Problem": e.Message}) }</a></li>
						}
					</ul>
				</div>
			}
			<form
				method="post"
				action={ templ.SafeURL(respondAction(data)) }
				class="respond-form js-respond-form"
				data-question-count={ strconv.Itoa(len(data.Questions)) }
				if data.Preview && data.PreviewAll {
					data-layout="all"
				}
				if !data.Preview && data.ParticipantToken == "" {
					data-challenge-url={ "/s/" + data.SurveyID + "/challenge" }
				}
				if data.VoiceEnabled() {
					data-voice-path={ data.VoicePath }
					data-voice-lang={ voiceLang(data.Lang) }
					data-voice-max-seconds={ strconv.Itoa(data.VoiceMaxSeconds) }
				}
				novalidate
			>
				<input type="hidden" name="version_id" value={ data.VersionID }/>
				<input type="hidden" name="started_at" value="" data-started-at/>
				<input type="hidden" name="form_ts" value={ data.FormToken }/>
				<input type="hidden" name="form_nonce" value={ data.Nonce }/>
				<input type="hidden" name="altcha" value="" data-altcha/>
				if data.Preview {
					<input type="hidden" name="_csrf" value={ data.CSRF }/>
				}
				// Honeypot: a real respondent never sees this, so anything
				// filling it in is automated (M4-T5).
				<div class="hp" aria-hidden="true">
					<label>
						{ t(ctx, "respond.honeypot.label") }
						<input type="text" name="website" tabindex="-1" autocomplete="off"/>
					</label>
				</div>
				<ol class="respond-questions js-respond-questions">
					for i, q := range data.Questions {
						@respondQuestion(q, i, len(data.Questions), data)
					}
				</ol>
				<div class="respond-actions js-respond-actions">
					<button type="submit" class="respond-submit">
						<span class="button-label">
							{ t(ctx, "respond.submit.label") }
							<svg class="button-icon" viewBox="0 0 24 24" aria-hidden="true" focusable="false">
								<path d="M22 2 11 13"></path>
								<path d="M22 2 15 22l-4-9-9-4z"></path>
							</svg>
						</span>
					</button>
				</div>
			</form>
		</main>
		// The wording of the scripts below, and then the script that reads
		// it, before any that says anything.
		if data.VoiceEnabled() {
			@jsText(ctx, "js.key", "js.respond", "respond.question.position",
				"js.voice", "voice.error.unavailable", "voice.status.transcribing")
		} else {
			@jsText(ctx, "js.key", "js.respond", "respond.question.position")
		}
		<script src={ static.AssetURL("js/uitext.js") } defer></script>
		if data.VoiceEnabled() {
			// The owl at the head of each dictation card, drawn here so the
			// script copies it rather than holding markup of its own.
			<template class="js-voice-owl">
				@owl(OwlListening, 22)
			</template>
			<script src={ static.AssetURL("js/wsclient.js") } defer></script>
			<script src={ static.AssetURL("js/voice.js") } defer></script>
		}
		<script src={ static.AssetURL("js/respond.js") } defer></script>
	}
}

func respondAction(data RespondData) string {
	switch {
	case data.Preview:
		return "/surveys/" + data.SurveyID + "/preview"
	case data.ParticipantToken != "":
		return withLang("/p/"+data.ParticipantToken, data.Lang)
	default:
		return withLang("/s/"+data.SurveyID, data.Lang)
	}
}

// withLang keeps the respondent's chosen language on the address the form
// posts to. The address is the only place the choice lives (story 25), so
// a form that dropped it would come back in another language the moment
// an answer needed correcting.
func withLang(path string, lang string) string {
	if lang == "" {
		return path
	}
	return path + "?lang=" + url.QueryEscape(lang)
}

// languagePicker offers the languages this version was published with
// (story 25). It is a plain form: choosing reloads the page in that
// language, and nothing about the choice is stored — no cookie, no
// column, nothing that could later say what language a respondent reads.
templ languagePicker(data RespondData) {
	if len(data.Languages) > 1 && !data.Preview {
		<form method="get" class="language-picker">
			<label class="field">
				<span>{ t(ctx, "respond.picker.label") }</span>
				<select name="lang" data-language-picker>
					for _, choice := range data.Languages {
						if choice.Selected {
							<option value={ choice.Code } selected>{ choice.Name }</option>
						} else if choice.Suggested {
							<option value={ choice.Code }>{ t(ctx, "respond.picker.suggested", uitext.Args{"Language": choice.Name}) }</option>
						} else {
							<option value={ choice.Code }>{ choice.Name }</option>
						}
					}
				</select>
			</label>
			<button type="submit">{ t(ctx, "respond.picker.submit") }</button>
		</form>
	}
}

// respondentDisclosure states who is running the survey and what happens
// to the answers, before anyone answers anything (SPEC.md story 63; the
// fuller M8-T5 treatment builds on this).
// respondentDisclosure states who is running the survey, what happens to
// the answers, and — when the mic is on offer — what happens to a voice
// (stories 63 and M8-T5). It is above the first question, not behind a
// link, because it is the thing a respondent needs before deciding to
// answer at all.
templ respondentDisclosure(data RespondData) {
	<div class="disclosure js-disclosure">
		<p>
			@thtml(ctx, "respond.disclosure.controller_html", uitext.Args{"Workspace": data.WorkspaceName})
			// The space between this sentence and the next. templ puts
			// one after text that a line break follows and none after a
			// component, which is what a sentence with markup in it is.
			{ sentenceGap }
			if data.IsAnonymous {
				{ t(ctx, "respond.disclosure.anonymous") }
			} else if data.ParticipantEmail != "" {
				@thtml(ctx, "respond.disclosure.identified_html", uitext.Args{"Email": data.ParticipantEmail, "Workspace": data.WorkspaceName})
			} else {
				{ t(ctx, "respond.disclosure.invited", uitext.Args{"Workspace": data.WorkspaceName}) }
			}
		</p>
		if data.VoiceEnabled() {
			<p>
				{ t(ctx, "respond.disclosure.voice") }
			</p>
		}
		if !data.Preview {
			// Story 79: the draft lives in this browser and nowhere else,
			// which is a better deal than a server-side draft would be —
			// but on a shared device it is still worth saying out loud.
			<p class="muted">
				{ t(ctx, "respond.disclosure.draft") }
			</p>
		}
		<p class="muted">
			<a href={ templ.SafeURL(withLang("/trust", data.Lang)) }>{ t(ctx, "respond.disclosure.trust") }</a>
		</p>
	</div>
}

// RespondAlreadySubmitted is the one-per-participant page (M4-T3).
templ RespondAlreadySubmitted(title string) {
	@RespondLayout(t(ctx, "respond.already.title"), "") {
		<main>
			<h1>{ t(ctx, "respond.already.heading") }</h1>
			if title != "" {
				<p class="muted">{ title }</p>
			}
			<p>{ t(ctx, "respond.already.body") }</p>
		</main>
	}
}

templ respondQuestion(q domain.Question, index int, total int, data RespondData) {
	<li
		class="respond-question js-respond-question"
		id={ "q-" + q.IdentityID }
		data-index={ strconv.Itoa(index) }
		if data.VoiceEnabled() && q.Type.AcceptsVoice() {
			data-voice="1"
		}
	>
		<fieldset>
			<legend>
				<span class="q-position">{ t(ctx, "respond.question.position", uitext.Args{"Current": index + 1, "Total": total}) }</span>
				<span class="q-text" id={ "qt-" + q.IdentityID }>{ q.Text }</span>
				if q.Required {
					<span class="q-required">{ t(ctx, "respond.question.required") }</span>
				} else {
					<span class="q-optional">{ t(ctx, "respond.question.optional") }</span>
				}
			</legend>
			if data.Errors[q.IdentityID] != "" {
				<p class="error-text" id={ "err-" + q.IdentityID }>{ data.Errors[q.IdentityID] }</p>
			}
			@answerControl(q, data)
			if data.Preview && q.Type.AcceptsVoice() {
				<p class="muted voice-preview-note">{ t(ctx, "respond.preview.voice") }</p>
			}
		</fieldset>
	</li>
}

// An answer is never an address, a card or a login, but a password
// manager cannot tell: a text field named q_… next to a question gets
// offered saved logins, on top of whatever the respondent is typing.
// autocomplete="off" is the standard way to say so; the vendor
// attributes are for the managers that ignore the standard one.
// On radios and checkboxes the same attribute stops the browser
// restoring a choice from its own form history after a reload or a
// return visit: the only answers a page shows are the ones the server
// rendered, so a shared device never hands one respondent's choice to
// the next. No control carries tabindex: native inputs are already in
// the tab order, and only the honeypot opts out of it.
templ answerControl(q domain.Question, data RespondData) {
	switch q.Type {
		case domain.LongText:
			<textarea
				name={ "q_" + q.IdentityID }
				rows="5"
				autocomplete="off"
				data-1p-ignore
				data-lpignore="true"
				data-bwignore
				aria-labelledby={ "qt-" + q.IdentityID }
				if data.Errors[q.IdentityID] != "" {
					aria-describedby={ "err-" + q.IdentityID }
				}
			>{ data.Answers[q.IdentityID].Text }</textarea>
		case domain.ShortText:
			<input
				type="text"
				name={ "q_" + q.IdentityID }
				value={ data.Answers[q.IdentityID].Text }
				autocomplete="off"
				data-1p-ignore
				data-lpignore="true"
				data-bwignore
				aria-labelledby={ "qt-" + q.IdentityID }
				if data.Errors[q.IdentityID] != "" {
					aria-describedby={ "err-" + q.IdentityID }
				}
			/>
		case domain.SingleChoice, domain.Dropdown:
			// Dropdown renders as this same list rather than a <select>:
			// a browser draws its own option popup, so there is nowhere
			// to put a key hint. The submitted name and value are
			// identical either way, so nothing downstream can tell.
			<div class="options">
				for i, opt := range q.Options {
					<label class="option">
						if data.Answers[q.IdentityID].Choice == opt {
							<input type="radio" name={ "q_" + q.IdentityID } value={ opt } checked autocomplete="off"/>
						} else {
							<input type="radio" name={ "q_" + q.IdentityID } value={ opt } autocomplete="off"/>
						}
						@keyHint(optionKey(i))
						<span>{ opt }</span>
					</label>
				}
			</div>
		case domain.MultipleChoice:
			<div class="options">
				for i, opt := range q.Options {
					<label class="option">
						if hasChoice(data.Answers[q.IdentityID].Choices, opt) {
							<input type="checkbox" name={ "q_" + q.IdentityID } value={ opt } checked autocomplete="off"/>
						} else {
							<input type="checkbox" name={ "q_" + q.IdentityID } value={ opt } autocomplete="off"/>
						}
						@keyHint(optionKey(i))
						<span>{ opt }</span>
					</label>
				}
			</div>
		case domain.RatingScale, domain.NPS:
			<div class="scale">
				for _, point := range q.ScalePoints() {
					<label class="scale-point js-scale-point">
						if numberEquals(data.Answers[q.IdentityID].Number, point) {
							<input type="radio" name={ "q_" + q.IdentityID } value={ strconv.Itoa(point) } checked autocomplete="off"/>
						} else {
							<input type="radio" name={ "q_" + q.IdentityID } value={ strconv.Itoa(point) } autocomplete="off"/>
						}
						<span>{ strconv.Itoa(point) }</span>
					</label>
				}
			</div>
			if q.Type == domain.NPS {
				<p class="scale-hint"><span>{ t(ctx, "respond.nps.low") }</span><span>{ t(ctx, "respond.nps.high") }</span></p>
			}
		case domain.YesNo:
			// Y and N rather than A and B: the initial is the obvious key
			// and it survives translation of the visible label.
			<div class="options">
				<label class="option">
					if boolEquals(data.Answers[q.IdentityID].Bool, true) {
						<input type="radio" name={ "q_" + q.IdentityID } value="yes" checked autocomplete="off"/>
					} else {
						<input type="radio" name={ "q_" + q.IdentityID } value="yes" autocomplete="off"/>
					}
					@keyHint("Y")
					<span>{ t(ctx, "answer.yes") }</span>
				</label>
				<label class="option">
					if boolEquals(data.Answers[q.IdentityID].Bool, false) {
						<input type="radio" name={ "q_" + q.IdentityID } value="no" checked autocomplete="off"/>
					} else {
						<input type="radio" name={ "q_" + q.IdentityID } value="no" autocomplete="off"/>
					}
					@keyHint("N")
					<span>{ t(ctx, "answer.no") }</span>
				</label>
			</div>
		case domain.Date:
			// The browser's own date control: it shows the day in the
			// respondent's locale and submits it as yyyy-mm-dd, which is
			// the form the server accepts. A browser without one shows a
			// text field, and the server's check covers that too.
			<input
				type="date"
				name={ "q_" + q.IdentityID }
				value={ data.Answers[q.IdentityID].Date }
				autocomplete="off"
				data-1p-ignore
				data-lpignore="true"
				data-bwignore
				aria-labelledby={ "qt-" + q.IdentityID }
				if data.Errors[q.IdentityID] != "" {
					aria-describedby={ "err-" + q.IdentityID }
				}
			/>
	}
}

// keyHint is the little [A] beside a control. aria-hidden is not
// decoration: without it the option's accessible name becomes "A Weekly"
// and every choice reads wrong to a screen reader. The key itself is
// carried in a data attribute so respond.js can build its map from the
// DOM rather than recomputing the same letters in two languages.
templ keyHint(key string) {
	if key != "" {
		<span class="key-hint js-key-hint" data-key={ key } aria-hidden="true">{ key }</span>
	}
}

// optionKey is the key a respondent presses to pick the nth option:
// A, B, C… by position, so it follows the localized option order and
// needs no server state. Past 26 options there is no key — the option
// still works by click and by Tab.
//
// Letters, not digits, and that is the whole trick: digits belong to
// rating scales, where 3 already means "a rating of 3". A survey mixing
// a choice question and a rating question would otherwise have the same
// key meaning two things.
func optionKey(index int) string {
	if index < 0 || index > 25 {
		return ""
	}
	return string(rune('A' + index))
}

func hasChoice(choices []string, want string) bool {
	for _, c := range choices {
		if c == want {
			return true
		}
	}
	return false
}

func numberEquals(got *int, want int) bool { return got != nil && *got == want }

func boolEquals(got *bool, want bool) bool { return got != nil && *got == want }

// ThanksData is what the page after a submission shows.
type ThanksData struct {
	Title     string
	Anonymous bool
	// Lang is the language the survey was answered in, empty for the
	// original wording, so the page declares what its questions are in.
	Lang string
	// Answers is the respondent's own submission, shown only in the
	// response to the POST that carried it: no address leads back to it,
	// so a shared device cannot reveal it later. It is empty wherever
	// nothing was recorded from this request.
	Answers []AnsweredQuestion
}

// AnsweredQuestion is one line of a submission read back to the person
// who sent it: the question as they read it and the answer as they gave
// it. Answer is empty for a question they skipped.
type AnsweredQuestion struct {
	Question string
	Answer   string
}

// RespondThanks closes the loop for the respondent.
templ RespondThanks(data ThanksData) {
	@RespondLayout(t(ctx, "respond.thanks.title", uitext.Args{"Survey": data.Title}), data.Lang) {
		<main class="standalone">
			@owl(OwlHappy, 96)
			<h1>{ t(ctx, "respond.thanks.heading") }</h1>
			<p>{ t(ctx, "respond.thanks.body") }</p>
			if data.Anonymous {
				<p class="muted">{ t(ctx, "respond.thanks.anonymous") }</p>
			}
			@answerSummary(data.Answers)
		</main>
	}
}

// answerSummary reads a submission back to the person who sent it.
templ answerSummary(answers []AnsweredQuestion) {
	if len(answers) > 0 {
		<section class="card js-answer-summary" aria-labelledby="answer-summary-heading">
			<h2 id="answer-summary-heading">{ t(ctx, "respond.summary.heading") }</h2>
			<dl class="facts">
				for _, a := range answers {
					<dt>{ a.Question }</dt>
					if a.Answer == "" {
						<dd class="muted">{ t(ctx, "respond.summary.skipped") }</dd>
					} else {
						<dd>{ a.Answer }</dd>
					}
				}
			</dl>
		</section>
	}
}

// RespondPreviewSubmitted is what a creator sees if they submit the
// preview form. Nothing is written; the page says so plainly, and reads
// back what was entered the way a respondent would see it.
templ RespondPreviewSubmitted(surveyID string, title string, answers []AnsweredQuestion) {
	@RespondLayout(t(ctx, "respond.preview.submitted.title", uitext.Args{"Survey": title}), "") {
		<main class="standalone">
			@owl(OwlHappy, 96)
			<h1>{ t(ctx, "respond.preview.submitted.heading") }</h1>
			<p>{ t(ctx, "respond.preview.submitted.body") }</p>
			@answerSummary(answers)
			<p><a class="button" href={ templ.SafeURL("/surveys/" + surveyID) }>{ t(ctx, "respond.preview.submitted.back") }</a></p>
		</main>
	}
}

// RespondUnavailable covers every reason a survey cannot be answered
// right now, in the respondent's language rather than ours.
templ RespondUnavailable(title string, heading string, message string) {
	@RespondLayout(heading, "") {
		<main class="standalone">
			@owl(OwlSurprised, 96)
			<h1>{ heading }</h1>
			if title != "" {
				<p class="muted">{ title }</p>
			}
			<p>{ message }</p>
		</main>
	}
}
