package templates

import "fmt"

// M12: the super-admin surface — invite-code minting/revocation and
// out-of-band password resets. Reachable only through requireSuperAdmin
// (non-admins get a 404, and the link only renders on admins' account
// pages). Code plaintext appears exactly once, in the mint response;
// the list below shows metadata only.

type BetaCodeRow struct {
	ID      string
	Label   string
	Created string
	Status  string // "unused", "used by <email>", "revoked"
}

templ BetaCodesAdmin(email string, csrf string, minted []string, resetEmail string, resetTemp string, codes []BetaCodeRow, errMsg string) {
	@Layout("Private beta admin — Earful") {
		@AuthedHeader(email, csrf)
		<main>
			<h1>Private beta admin</h1>
			if errMsg != "" {
				<p class="error-text">{ errMsg }</p>
			}
			if len(minted) > 0 {
				<div class="card">
					<h2>New invite codes — copy them now</h2>
					<p class="muted">This is the only time they are shown; the database stores hashes.</p>
					<ul class="code-list">
						for _, c := range minted {
							<li><code>{ c }</code></li>
						}
					</ul>
				</div>
			}
			if resetTemp != "" {
				<div class="card">
					<h2>Temporary password for { resetEmail }</h2>
					<p><code>{ resetTemp }</code></p>
					<p class="muted">Shown once. Every session for that account has been signed out; pass the password on out-of-band and suggest they change it.</p>
				</div>
			}
			<div class="card">
				<h2>Mint invite codes</h2>
				<form method="post" action="/admin/beta-codes">
					<input type="hidden" name="_csrf" value={ csrf }/>
					<label class="field">
						<span>How many</span>
						<input type="number" name="count" value="1" min="1" max="50" required/>
					</label>
					<label class="field">
						<span>Label</span>
						<input type="text" name="label" placeholder="e.g. first-wave friends"/>
					</label>
					<button type="submit">Mint codes</button>
				</form>
			</div>
			<div class="card">
				<h2>Reset a user's password</h2>
				<form method="post" action="/admin/reset-password">
					<input type="hidden" name="_csrf" value={ csrf }/>
					<label class="field">
						<span>Account email</span>
						<input type="email" name="email" required/>
					</label>
					<button type="submit" class="danger">Reset password</button>
				</form>
				<p class="muted">The beta's answer to "I forgot my password" — there is no email to send a reset link to yet.</p>
			</div>
			<div class="card">
				<h2>All codes</h2>
				if len(codes) == 0 {
					<p class="muted">No codes yet — mint some above, or via <code>earful beta-codes add</code>.</p>
				} else {
					<div class="table-scroll">
						<table>
							<thead>
								<tr><th>Label</th><th>Created</th><th>Status</th><th></th></tr>
							</thead>
							<tbody>
								for _, c := range codes {
									<tr>
										<td>{ c.Label }</td>
										<td>{ c.Created }</td>
										<td>{ c.Status }</td>
										<td>
											if c.Status == "unused" {
												<form method="post" action="/admin/beta-codes/revoke">
													<input type="hidden" name="_csrf" value={ csrf }/>
													<input type="hidden" name="id" value={ c.ID }/>
													<button type="submit" class="button-link">Revoke</button>
												</form>
											}
										</td>
									</tr>
								}
							</tbody>
						</table>
					</div>
				}
			</div>
		</main>
	}
}

// AdminErasure is the GDPR fast-path (M8-T3): look up a subject, see
// exactly what would go, then confirm. Support-only, like everything
// else under /admin — a non-admin gets a 404 from the route, so this
// page does not exist as far as they can tell.
templ AdminErasure(email string, csrf string, data ErasureData) {
	@Layout("Erasure — Earful") {
		@AuthedHeader(email, csrf)
		<main>
			<h1>Erase a person's data</h1>
			<p class="muted">
				For a GDPR erasure request. This skips the 30-day window: what it removes is gone
				immediately and cannot be restored.
			</p>

			if data.Done {
				<div class="card">
					<p class="notice">Erasure complete — { fmt.Sprint(data.ErasedRow) } rows removed.</p>
					<p class="muted">
						Record the request and this completion in your own log; Earful deliberately keeps
						no record naming the person erased.
					</p>
				</div>
			}

			<div class="card">
				<h2>Find the subject</h2>
				<form method="get" action="/admin/erasure">
					<label class="field">
						<span>Email address</span>
						<input type="email" name="email" required autocomplete="off" value={ data.Subject.Email }/>
					</label>
					<button type="submit" class="secondary">Look up</button>
				</form>
			</div>

			if data.Searched {
				<div class="card">
					<h2>What would be erased</h2>
					if !data.Subject.Found {
						<p>Nothing found for <strong>{ data.Subject.Email }</strong>.</p>
					} else {
						<ul>
							if data.Subject.HasAccount {
								<li>Their account, and every session and sign-in token it has</li>
							}
							if data.Subject.Workspaces > 0 {
								<li>{ fmt.Sprint(data.Subject.Workspaces) } workspace(s), with { fmt.Sprint(data.Subject.Surveys) } survey(s) and every response to them</li>
							}
							if data.Subject.ParticipantIn > 0 {
								<li>
									Their invitations to { fmt.Sprint(data.Subject.ParticipantIn) } survey(s) run by others,
									and the { fmt.Sprint(data.Subject.Responses) } response(s) they submitted there
								</li>
							}
							if data.Subject.Suppressed {
								<li>Their entry on the email suppression list</li>
							}
						</ul>
						<form method="post" action="/admin/erasure">
							<input type="hidden" name="_csrf" value={ csrf }/>
							<input type="hidden" name="email" value={ data.Subject.Email }/>
							<button type="submit" class="danger">Erase this data now</button>
						</form>
					}
					<p class="muted">
						Anonymous responses are not listed and cannot be: they carry no email, no IP and no
						device details, so there is no way to tell which are theirs — and nothing personal in
						them to erase. That is the anonymity promise working as intended, and it is worth
						saying so in your reply to the request.
					</p>
				</div>
			}
		</main>
	}
}

// AdminMetrics is M9-T7: the numbers needed to steer the product, none
// of which cost a respondent anything. Deliberately plain — this is a
// place to read six figures, not a dashboard to admire.
templ AdminMetrics(email string, csrf string, data MetricsData) {
	@Layout("Metrics — Earful") {
		@AuthedHeader(email, csrf)
		<main>
			<h1>Metrics</h1>
			<p class="muted">
				From our own database. Nothing is added to respondent pages to produce these, and
				completion rate comes from unlinked survey counters, never from anything joined to a
				response. Definitions: <code>docs/metrics.md</code>.
			</p>

			<section class="card">
				<h2>Totals</h2>
				<dl class="stat-grid">
					for _, total := range data.Totals {
						<div>
							<dt>{ total.Label }</dt>
							<dd>{ total.Value }</dd>
						</div>
					}
				</dl>
			</section>

			@metricSeries("Signups", data.Signups, data.WindowDays)
			@metricSeries("Responses", data.Responses, data.WindowDays)

			<section class="card">
				<h2>AI spend (estimated)</h2>
				<p class="muted">{ data.BudgetNote }</p>
				<p><strong>{ data.AICostTotal }</strong> over the last { fmt.Sprint(data.WindowDays) } days.</p>
				@metricRows(data.AICost)
			</section>
		</main>
	}
}

templ metricSeries(title string, points []MetricPoint, windowDays int) {
	<section class="card">
		<h2>{ title }</h2>
		<p class="muted">Last { fmt.Sprint(windowDays) } days.</p>
		@metricRows(points)
	</section>
}

templ metricRows(points []MetricPoint) {
	if len(points) == 0 {
		<p class="muted">Nothing yet.</p>
	} else {
		<div class="table-scroll">
			<table class="responses">
				<tbody>
					for _, point := range points {
						<tr>
							<td>{ point.Day }</td>
							<td>{ point.Value }</td>
						</tr>
					}
				</tbody>
			</table>
		</div>
	}
}
