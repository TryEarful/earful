package templates

import "github.com/TryEarful/earful/internal/uitext"

// M12: the super-admin surface — invite-code minting/revocation and
// out-of-band password resets. Reachable only through requireSuperAdmin
// (non-admins get a 404, and the link only renders on admins' account
// pages). Code plaintext appears exactly once, in the mint response;
// the list below shows metadata only.

type BetaCodeRow struct {
	ID      string
	Label   string
	Created string
	Status  string // "unused", "used by <email>", "revoked"
	// Revocable is true of a code nobody has used and nobody has
	// revoked. It is a field of its own because Status is wording, and
	// wording is not something to decide by.
	Revocable bool
}

templ BetaCodesAdmin(email string, csrf string, minted []string, resetEmail string, resetTemp string, codes []BetaCodeRow, errMsg string) {
	@Layout(t(ctx, "admin.beta.title")) {
		@AuthedHeader(email, csrf)
		<main>
			<h1>{ t(ctx, "admin.beta.heading") }</h1>
			if errMsg != "" {
				<p class="error-text">{ errMsg }</p>
			}
			if len(minted) > 0 {
				<div class="card js-panel">
					<h2>{ t(ctx, "admin.beta.minted.heading") }</h2>
					<p class="muted">{ t(ctx, "admin.beta.minted.note") }</p>
					<ul class="code-list">
						for _, c := range minted {
							<li><code>{ c }</code></li>
						}
					</ul>
				</div>
			}
			if resetTemp != "" {
				<div class="card js-panel">
					<h2>{ t(ctx, "admin.beta.reset.shown", uitext.Args{"Email": resetEmail}) }</h2>
					<p><code>{ resetTemp }</code></p>
					<p class="muted">{ t(ctx, "admin.beta.reset.note") }</p>
				</div>
			}
			<div class="card js-panel">
				<h2>{ t(ctx, "admin.beta.mint.heading") }</h2>
				<form method="post" action="/admin/beta-codes">
					<input type="hidden" name="_csrf" value={ csrf }/>
					<label class="field">
						<span>{ t(ctx, "admin.beta.mint.count") }</span>
						<input type="number" name="count" value="1" min="1" max="50" required/>
					</label>
					<label class="field">
						<span>{ t(ctx, "admin.beta.mint.name.label") }</span>
						<input type="text" name="label" placeholder={ t(ctx, "admin.beta.mint.name.placeholder") }/>
					</label>
					<button type="submit">{ t(ctx, "admin.beta.mint.submit.label") }</button>
				</form>
			</div>
			<div class="card js-panel">
				<h2>{ t(ctx, "admin.beta.reset.heading") }</h2>
				<form method="post" action="/admin/reset-password">
					<input type="hidden" name="_csrf" value={ csrf }/>
					<label class="field">
						<span>{ t(ctx, "admin.beta.reset.email") }</span>
						<input type="email" name="email" required/>
					</label>
					<button type="submit" class="danger">{ t(ctx, "admin.beta.reset.submit.label") }</button>
				</form>
				<p class="muted">{ t(ctx, "admin.beta.reset.hint") }</p>
			</div>
			<div class="card js-panel">
				<h2>{ t(ctx, "admin.beta.codes.heading") }</h2>
				if len(codes) == 0 {
					<p class="muted">
						@thtml(ctx, "admin.beta.codes.empty_html")
					</p>
				} else {
					<div class="table-scroll" tabindex="0">
						<table>
							<thead>
								<tr><th>{ t(ctx, "admin.beta.mint.name.label") }</th><th>{ t(ctx, "admin.beta.codes.created") }</th><th>{ t(ctx, "admin.beta.codes.status") }</th><th></th></tr>
							</thead>
							<tbody>
								for _, c := range codes {
									<tr>
										<td>{ c.Label }</td>
										<td>{ c.Created }</td>
										<td>{ c.Status }</td>
										<td>
											if c.Revocable {
												<form method="post" action="/admin/beta-codes/revoke">
													<input type="hidden" name="_csrf" value={ csrf }/>
													<input type="hidden" name="id" value={ c.ID }/>
													<button type="submit" class="button-link">{ t(ctx, "admin.beta.codes.revoke.label") }</button>
												</form>
											}
										</td>
									</tr>
								}
							</tbody>
						</table>
					</div>
				}
			</div>
		</main>
	}
}

// AdminErasure is the GDPR fast-path (M8-T3): look up a subject, see
// exactly what would go, then confirm. Support-only, like everything
// else under /admin — a non-admin gets a 404 from the route, so this
// page does not exist as far as they can tell.
templ AdminErasure(email string, csrf string, data ErasureData) {
	@Layout(t(ctx, "admin.erasure.title")) {
		@AuthedHeader(email, csrf)
		<main>
			<h1>{ t(ctx, "admin.erasure.heading") }</h1>
			<p class="muted">
				{ t(ctx, "admin.erasure.intro") }
			</p>

			if data.Done {
				<div class="card js-panel">
					<p class="notice">{ t(ctx, "admin.erasure.done", uitext.Args{"Rows": data.ErasedRow}) }</p>
					<p class="muted">
						{ t(ctx, "admin.erasure.record") }
					</p>
				</div>
			}

			<div class="card js-panel">
				<h2>{ t(ctx, "admin.erasure.find.heading") }</h2>
				<form method="get" action="/admin/erasure">
					<label class="field">
						<span>{ t(ctx, "auth.email.label") }</span>
						<input type="email" name="email" required autocomplete="off" value={ data.Subject.Email }/>
					</label>
					<button type="submit" class="secondary">{ t(ctx, "admin.erasure.find.submit.label") }</button>
				</form>
			</div>

			if data.Searched {
				<div class="card js-panel">
					<h2>{ t(ctx, "admin.erasure.found.heading") }</h2>
					if !data.Subject.Found {
						<p>
							@thtml(ctx, "admin.erasure.found.nothing_html", uitext.Args{"Email": data.Subject.Email})
						</p>
					} else {
						<ul>
							if data.Subject.HasAccount {
								<li>{ t(ctx, "admin.erasure.found.account") }</li>
							}
							if data.Subject.Workspaces > 0 {
								<li>{ t(ctx, "admin.erasure.found.workspaces", uitext.Args{"Workspaces": data.Subject.Workspaces, "Surveys": data.Subject.Surveys}) }</li>
							}
							if data.Subject.ParticipantIn > 0 {
								<li>
									{ t(ctx, "admin.erasure.found.invitations", uitext.Args{"Surveys": data.Subject.ParticipantIn, "Responses": data.Subject.Responses}) }
								</li>
							}
							if data.Subject.Suppressed {
								<li>{ t(ctx, "admin.erasure.found.suppressed") }</li>
							}
						</ul>
						<form method="post" action="/admin/erasure">
							<input type="hidden" name="_csrf" value={ csrf }/>
							<input type="hidden" name="email" value={ data.Subject.Email }/>
							<button type="submit" class="danger">{ t(ctx, "admin.erasure.submit.label") }</button>
						</form>
					}
					<p class="muted">
						{ t(ctx, "admin.erasure.found.anonymous") }
					</p>
				</div>
			}
		</main>
	}
}

// AdminAITiers sets a workspace's AI tier (issue #3): find an account,
// then choose the tier of each workspace it belongs to. Support only,
// like everything else under /admin.
templ AdminAITiers(email string, csrf string, data AITiersData) {
	@Layout(t(ctx, "admin.tiers.title")) {
		@AuthedHeader(email, csrf)
		<main>
			<h1>{ t(ctx, "admin.tiers.heading") }</h1>
			<p class="muted">{ t(ctx, "admin.tiers.intro") }</p>
			if data.Notice != "" {
				<p class="notice" role="status">{ data.Notice }</p>
			}
			if data.Error != "" {
				<p class="notice error-text" role="alert">{ data.Error }</p>
			}
			if data.Searched && len(data.Workspaces) == 0 {
				<p class="notice" role="status">
					@thtml(ctx, "admin.tiers.none_html", uitext.Args{"Email": data.Email})
				</p>
			}
			<div class="card js-panel">
				<h2>{ t(ctx, "admin.tiers.find.heading") }</h2>
				<form method="get" action="/admin/ai-tiers">
					<label class="field">
						<span>{ t(ctx, "auth.email.label") }</span>
						<input type="email" name="email" required autocomplete="off" value={ data.Email }/>
					</label>
					if data.Searched && len(data.Workspaces) > 0 {
						<button type="submit" class="secondary">{ t(ctx, "admin.tiers.find.submit.label") }</button>
					} else {
						<button type="submit">{ t(ctx, "admin.tiers.find.submit.label") }</button>
					}
				</form>
			</div>
			if len(data.Workspaces) > 0 {
				<div class="card js-panel">
					<h2>{ t(ctx, "admin.tiers.results") }</h2>
					for _, ws := range data.Workspaces {
						<form method="post" action="/admin/ai-tiers" class="js-tier-form">
							<h3>{ ws.Name }</h3>
							<p class="muted">{ ws.Usage }</p>
							<input type="hidden" name="_csrf" value={ csrf }/>
							<input type="hidden" name="email" value={ data.Email }/>
							<input type="hidden" name="workspace" value={ ws.ID }/>
							<label class="field">
								<span>{ t(ctx, "admin.tiers.tier.label") }</span>
								<select name="tier" class="js-tier">
									for _, option := range data.Options {
										<option value={ option.Value } selected?={ option.Value == ws.Tier }>{ option.Label }</option>
									}
								</select>
							</label>
							// One filled button per page: with several workspaces
							// listed, no one save outranks the others.
							if len(data.Workspaces) > 1 {
								<button type="submit" class="secondary">{ t(ctx, "admin.tiers.save.label") }</button>
							} else {
								<button type="submit">{ t(ctx, "admin.tiers.save.label") }</button>
							}
						</form>
					}
				</div>
			}
		</main>
	}
}

// AdminMetrics is M9-T7: the numbers needed to steer the product, none
// of which cost a respondent anything. Deliberately plain — this is a
// place to read six figures, not a dashboard to admire.
templ AdminMetrics(email string, csrf string, data MetricsData) {
	@Layout(t(ctx, "admin.metrics.title")) {
		@AuthedHeader(email, csrf)
		<main>
			<h1>{ t(ctx, "admin.metrics.heading") }</h1>
			<p class="muted">
				@thtml(ctx, "admin.metrics.intro_html")
			</p>

			<section class="card js-panel">
				<h2>{ t(ctx, "admin.metrics.totals") }</h2>
				<dl class="stat-grid">
					for _, total := range data.Totals {
						<div>
							<dt>{ total.Label }</dt>
							<dd>{ total.Value }</dd>
						</div>
					}
				</dl>
			</section>

			@metricSeries(t(ctx, "admin.metrics.signups"), data.Signups, data.WindowDays)
			@metricSeries(t(ctx, "admin.metrics.responses"), data.Responses, data.WindowDays)

			<section class="card js-panel">
				<h2>{ t(ctx, "admin.metrics.spend.heading") }</h2>
				<p class="muted">{ data.BudgetNote }</p>
				<p>
					@thtml(ctx, "admin.metrics.spend.total_html", uitext.Args{"Cost": data.AICostTotal, "Days": data.WindowDays})
				</p>
				@metricRows(data.AICost)
			</section>
		</main>
	}
}

templ metricSeries(title string, points []MetricPoint, windowDays int) {
	<section class="card js-panel">
		<h2>{ title }</h2>
		<p class="muted">{ t(ctx, "admin.metrics.window", uitext.Args{"Days": windowDays}) }</p>
		@metricRows(points)
	</section>
}

templ metricRows(points []MetricPoint) {
	if len(points) == 0 {
		<p class="muted">{ t(ctx, "admin.metrics.empty") }</p>
	} else {
		<div class="table-scroll" tabindex="0">
			<table class="responses">
				<tbody>
					for _, point := range points {
						<tr>
							<td>{ point.Day }</td>
							<td>{ point.Value }</td>
						</tr>
					}
				</tbody>
			</table>
		</div>
	}
}

// AdminSuspensions suspends a workspace that misuses the service and
// lifts the suspension (ADR-0018): the suspended workspaces first, then
// a workspace found through a member's address, as the other support
// tools find an account. Support only, like everything else under
// /admin. Suspending is a danger button with a reason beside it; lifting
// puts everything back, so it is an outlined one.
templ AdminSuspensions(email string, csrf string, data SuspensionsData) {
	@Layout(t(ctx, "admin.suspensions.title")) {
		@AuthedHeader(email, csrf)
		<main>
			<h1>{ t(ctx, "admin.suspensions.heading") }</h1>
			<p class="muted">{ t(ctx, "admin.suspensions.intro") }</p>
			if data.Notice != "" {
				<p class="notice" role="status">{ data.Notice }</p>
			}
			// A problem with a reason is said at its field; the others, here.
			if data.Error != "" && data.ReasonFor == "" {
				<p class="notice error-text js-suspension-error" role="alert">{ data.Error }</p>
			}
			// With nothing suspended, the page says so in a line rather
			// than a card that holds only that line.
			if len(data.Suspended) == 0 {
				<p class="js-suspended-list">{ t(ctx, "admin.suspensions.list.empty") }</p>
			} else {
				<div class="card js-panel js-suspended-list">
					<h2>{ t(ctx, "admin.suspensions.list.heading") }</h2>
					for _, ws := range data.Suspended {
						<form method="post" action="/admin/suspensions/lift" class="suspension-row js-suspended">
							<h3>{ ws.Name }</h3>
							<dl class="facts">
								if ws.Member != "" {
									<dt>{ t(ctx, "admin.suspensions.member") }</dt>
									<dd>{ ws.Member }</dd>
								}
								<dt>{ t(ctx, "admin.suspensions.since") }</dt>
								<dd>
									if ws.By != "" {
										{ t(ctx, "admin.suspensions.since_by", uitext.Args{"Day": ws.Since, "By": ws.By}) }
									} else {
										{ ws.Since }
									}
								</dd>
								<dt>{ t(ctx, "admin.suspensions.reason_term") }</dt>
								<dd>{ ws.Reason }</dd>
							</dl>
							<input type="hidden" name="_csrf" value={ csrf }/>
							<input type="hidden" name="email" value={ data.Email }/>
							<input type="hidden" name="workspace" value={ ws.ID }/>
							<button type="submit" class="secondary js-lift">{ t(ctx, "admin.suspensions.lift.label") }</button>
						</form>
					}
				</div>
			}
			<div class="card js-panel">
				<h2>{ t(ctx, "admin.suspensions.find.heading") }</h2>
				<form method="get" action="/admin/suspensions">
					<label class="field">
						<span>{ t(ctx, "auth.email.label") }</span>
						<input type="email" name="email" required autocomplete="off" value={ data.Email }/>
					</label>
					// One filled button per page; once workspaces are found,
					// the page's main action is with them.
					if data.Searched && len(data.Found) > 0 {
						<button type="submit" class="secondary">{ t(ctx, "admin.suspensions.find.submit.label") }</button>
					} else {
						<button type="submit">{ t(ctx, "admin.suspensions.find.submit.label") }</button>
					}
				</form>
				if data.Searched && len(data.Found) == 0 {
					<p class="muted" role="status">
						@thtml(ctx, "admin.suspensions.none_html", uitext.Args{"Email": data.Email})
					</p>
				}
			</div>
			if len(data.Found) > 0 {
				<div class="card js-panel">
					<h2>{ t(ctx, "admin.suspensions.results") }</h2>
					for _, ws := range data.Found {
						<div class="suspension-row js-found-workspace">
							<h3>{ ws.Name }</h3>
							if ws.Suspended {
								<p class="muted">{ t(ctx, "admin.suspensions.found.suspended") }</p>
							} else {
								<form method="post" action="/admin/suspensions" class="js-suspend-form">
									<input type="hidden" name="_csrf" value={ csrf }/>
									<input type="hidden" name="email" value={ data.Email }/>
									<input type="hidden" name="workspace" value={ ws.ID }/>
									<label class="field">
										<span>{ t(ctx, "admin.suspensions.reason.label") }</span>
										<textarea
											id={ "reason-" + ws.ID }
											name="reason"
											rows="3"
											maxlength="500"
											required
											if data.ReasonFor == ws.ID {
												aria-invalid="true"
												aria-describedby={ "reason-error-" + ws.ID + " reason-hint-" + ws.ID }
												autofocus
											} else {
												aria-describedby={ "reason-hint-" + ws.ID }
											}
										>
											if data.ReasonFor == ws.ID {
												{ data.Reason }
											}
										</textarea>
									</label>
									if data.ReasonFor == ws.ID {
										<p class="error-text js-suspension-error" id={ "reason-error-" + ws.ID } role="alert">{ data.Error }</p>
									}
									<p class="muted" id={ "reason-hint-" + ws.ID }>{ t(ctx, "admin.suspensions.reason.hint") }</p>
									<button type="submit" class="secondary danger js-suspend">{ t(ctx, "admin.suspensions.suspend.label") }</button>
								</form>
							}
						</div>
					}
				</div>
			}
		</main>
	}
}
