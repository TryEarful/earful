package templates

// M12: the super-admin surface — invite-code minting/revocation and
// out-of-band password resets. Reachable only through requireSuperAdmin
// (non-admins get a 404, and the link only renders on admins' account
// pages). Code plaintext appears exactly once, in the mint response;
// the list below shows metadata only.

type BetaCodeRow struct {
	ID      string
	Label   string
	Created string
	Status  string // "unused", "used by <email>", "revoked"
}

templ BetaCodesAdmin(email string, csrf string, minted []string, resetEmail string, resetTemp string, codes []BetaCodeRow, errMsg string) {
	@Layout("Private beta admin — Earful") {
		@AuthedHeader(email, csrf)
		<main>
			<h1>Private beta admin</h1>
			if errMsg != "" {
				<p class="error-text">{ errMsg }</p>
			}
			if len(minted) > 0 {
				<div class="card">
					<h2>New invite codes — copy them now</h2>
					<p class="muted">This is the only time they are shown; the database stores hashes.</p>
					<ul class="code-list">
						for _, c := range minted {
							<li><code>{ c }</code></li>
						}
					</ul>
				</div>
			}
			if resetTemp != "" {
				<div class="card">
					<h2>Temporary password for { resetEmail }</h2>
					<p><code>{ resetTemp }</code></p>
					<p class="muted">Shown once. Every session for that account has been signed out; pass the password on out-of-band and suggest they change it.</p>
				</div>
			}
			<div class="card">
				<h2>Mint invite codes</h2>
				<form method="post" action="/admin/beta-codes">
					<input type="hidden" name="_csrf" value={ csrf }/>
					<label class="field">
						<span>How many</span>
						<input type="number" name="count" value="1" min="1" max="50" required/>
					</label>
					<label class="field">
						<span>Label</span>
						<input type="text" name="label" placeholder="e.g. first-wave friends"/>
					</label>
					<button type="submit">Mint codes</button>
				</form>
			</div>
			<div class="card">
				<h2>Reset a user's password</h2>
				<form method="post" action="/admin/reset-password">
					<input type="hidden" name="_csrf" value={ csrf }/>
					<label class="field">
						<span>Account email</span>
						<input type="email" name="email" required/>
					</label>
					<button type="submit" class="danger">Reset password</button>
				</form>
				<p class="muted">The beta's answer to "I forgot my password" — there is no email to send a reset link to yet.</p>
			</div>
			<div class="card">
				<h2>All codes</h2>
				if len(codes) == 0 {
					<p class="muted">No codes yet — mint some above, or via <code>earful beta-codes add</code>.</p>
				} else {
					<div class="table-scroll">
						<table>
							<thead>
								<tr><th>Label</th><th>Created</th><th>Status</th><th></th></tr>
							</thead>
							<tbody>
								for _, c := range codes {
									<tr>
										<td>{ c.Label }</td>
										<td>{ c.Created }</td>
										<td>{ c.Status }</td>
										<td>
											if c.Status == "unused" {
												<form method="post" action="/admin/beta-codes/revoke">
													<input type="hidden" name="_csrf" value={ csrf }/>
													<input type="hidden" name="id" value={ c.ID }/>
													<button type="submit" class="button-link">Revoke</button>
												</form>
											}
										</td>
									</tr>
								}
							</tbody>
						</table>
					</div>
				}
			</div>
		</main>
	}
}
