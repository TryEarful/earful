package templates

import "github.com/TryEarful/earful/internal/uitext"

// Login is the combined sign-in page. In beta mode (M12) it is an
// email+password form with a pointer to invite-code signup — no email is
// ever sent; otherwise it is the magic-link email form. Google appears
// in both when OIDC is configured (self-hosters may run without it,
// Appendix D). errMsg re-renders the form after a rejected submission;
// notice carries post-redirect messages ("signed out").
templ Login(googleEnabled bool, betaMode bool, errMsg string, notice string) {
	@Layout(t(ctx, "login.title")) {
		@authBrand()
		<main class="standalone">
			<h1>{ t(ctx, "login.heading") }</h1>
			if notice != "" {
				<p class="notice">{ notice }</p>
			}
			if betaMode {
				<div class="card js-panel">
					<form method="post" action="/login">
						<label class="field">
							<span>{ t(ctx, "auth.email.label") }</span>
							<input type="email" name="email" required autocomplete="email" autofocus/>
						</label>
						<label class="field">
							<span>{ t(ctx, "auth.password.label") }</span>
							<input type="password" name="password" required autocomplete="current-password"/>
						</label>
						if errMsg != "" {
							<p class="error-text">{ errMsg }</p>
						}
						<button type="submit">{ t(ctx, "login.submit.label") }</button>
					</form>
					<p class="muted">
						@thtml(ctx, "login.beta.note_html")
					</p>
				</div>
			} else {
				<div class="card js-panel">
					<form method="post" action="/auth/magic/request">
						<label class="field">
							<span>{ t(ctx, "auth.email.label") }</span>
							<input type="email" name="email" required autocomplete="email" autofocus/>
						</label>
						if errMsg != "" {
							<p class="error-text">{ errMsg }</p>
						}
						<button type="submit">{ t(ctx, "login.magic.submit.label") }</button>
					</form>
					<p class="muted">{ t(ctx, "login.magic.hint") }</p>
				</div>
			}
			if googleEnabled {
				<div class="divider">{ t(ctx, "login.google.divider") }</div>
				<a class="button secondary" href="/auth/google/start" rel="nofollow">{ t(ctx, "login.google.label") }</a>
			}
		</main>
	}
}

// Signup is the invite-code account creation form (M12). The code is a
// one-shot key: it creates exactly one account, gets marked used, and
// the new user is signed in immediately — no confirmation email exists
// to send.
templ Signup(errMsg string) {
	@Layout(t(ctx, "signup.title")) {
		@authBrand()
		<main class="standalone">
			<h1>{ t(ctx, "signup.heading") }</h1>
			<div class="card js-panel">
				<form method="post" action="/signup">
					<label class="field">
						<span>{ t(ctx, "signup.code.label") }</span>
						<input type="text" name="code" required autocomplete="off" placeholder="earful-xxxx-xxxx-xxxx" autofocus/>
					</label>
					<label class="field">
						<span>{ t(ctx, "auth.email.label") }</span>
						<input type="email" name="email" required autocomplete="email"/>
					</label>
					<label class="field">
						<span>{ t(ctx, "auth.password.label") }</span>
						<input type="password" name="password" required autocomplete="new-password" minlength="8"/>
					</label>
					if errMsg != "" {
						<p class="error-text">{ errMsg }</p>
					}
					<button type="submit">{ t(ctx, "signup.submit.label") }</button>
				</form>
				<p class="muted">
					@thtml(ctx, "signup.note_html")
				</p>
			</div>
		</main>
	}
}

templ MagicSent(email string) {
	@Layout(t(ctx, "magic.sent.title")) {
		@authBrand()
		<main class="standalone">
			<h1>{ t(ctx, "magic.sent.heading") }</h1>
			<div class="card js-panel">
				<p>
					@thtml(ctx, "magic.sent.body_html", uitext.Args{"Email": email})
				</p>
				<p class="muted">
					@thtml(ctx, "magic.sent.retry_html")
				</p>
			</div>
		</main>
	}
}

// MagicConfirm is the page behind the emailed link. Signing in requires
// pressing the button (a POST): link-prefetching email scanners only ever
// GET, so they cannot consume the single-use token.
templ MagicConfirm(email string, token string) {
	@Layout(t(ctx, "magic.confirm.title")) {
		@authBrand()
		<main class="standalone">
			<h1>{ t(ctx, "magic.confirm.heading") }</h1>
			<div class="card js-panel">
				<p>
					@thtml(ctx, "magic.confirm.question_html", uitext.Args{"Email": email})
				</p>
				<form method="post" action="/auth/magic/verify">
					<input type="hidden" name="token" value={ token }/>
					<button type="submit">{ t(ctx, "magic.confirm.submit.label") }</button>
				</form>
				<p class="muted">{ t(ctx, "magic.confirm.note") }</p>
			</div>
		</main>
	}
}

templ MagicInvalid(reason string) {
	@Layout(t(ctx, "magic.invalid.title")) {
		@authBrand()
		<main class="standalone">
			@owl(OwlSurprised, 88)
			<h1>{ t(ctx, "magic.invalid.heading") }</h1>
			<p>{ reason }</p>
			<p><a class="button" href="/login">{ t(ctx, "magic.invalid.back.label") }</a></p>
		</main>
	}
}

templ ErrorPage(title string, msg string) {
	@Layout(t(ctx, "page.title", uitext.Args{"Title": title})) {
		@authBrand()
		<main class="standalone">
			<h1>{ title }</h1>
			<p>{ msg }</p>
			<p><a href="/">{ t(ctx, "page.home.label") }</a></p>
		</main>
	}
}

// Goodbye closes an account's last page. copySent is whether a copy of
// the data was asked for, which the page confirms is on its way.
templ Goodbye(copySent bool) {
	@Layout(t(ctx, "goodbye.title")) {
		@authBrand()
		<main class="standalone">
			<h1>{ t(ctx, "goodbye.heading") }</h1>
			<p>{ t(ctx, "goodbye.body") }</p>
			if copySent {
				<p class="notice js-goodbye-copy" role="status">{ t(ctx, "goodbye.copy") }</p>
			}
			<p class="muted">{ t(ctx, "goodbye.again") }</p>
			<p><a href="/">{ t(ctx, "page.home.label") }</a></p>
		</main>
	}
}
