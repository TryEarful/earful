package templates

import (
	"strconv"

	"github.com/TryEarful/earful/internal/uitext"
	"github.com/TryEarful/earful/web/static"
)

// SurveyStats is the creator's read of how a survey is going over time
// (issue #2, ADR-0012): opened, submitted, completion rate, submissions a
// day and time to complete for a date range, a chart of the same, and the question where
// answers stop. The audience section keeps no dates on purpose and says
// so — see ADR-0012 for the subtraction attack a dated audience count
// would allow.
//
// The page renders complete without JavaScript: the chart's numbers are
// a table until stats.js draws them, and the table stays reachable
// afterwards.
templ SurveyStats(email string, csrf string, data SurveyStatsData) {
	@Layout(t(ctx, "stats.title", uitext.Args{"Survey": data.Survey.Title})) {
		@AuthedHeader(email, csrf)
		<main class="stats-page">
			<nav class="breadcrumb" aria-label={ t(ctx, "breadcrumb.aria") }>
				<a href="/surveys">{ t(ctx, "breadcrumb.surveys") }</a> /
				<a href={ templ.SafeURL("/surveys/" + data.Survey.ID) }>{ data.Survey.Title }</a> /
				{ t(ctx, "stats.heading") }
			</nav>
			<div class="title-row">
				<h1>{ t(ctx, "stats.heading") }</h1>
				@StatusChip(data.Survey.Status)
			</div>
			@surveyTabs(data.Survey, "stats")
			@rangeControl(data)
			<section class="card js-panel">
				<h2>{ t(ctx, "stats.picture.heading") }</h2>
				<dl class="stat-grid">
					<div>
						<dt>{ t(ctx, "stats.opened.label") }</dt>
						<dd>{ data.Opened }</dd>
					</div>
					<div>
						<dt>{ t(ctx, "stats.submissions.label") }</dt>
						<dd>{ data.Submissions }</dd>
					</div>
					if data.CompletionRate != "" {
						<div>
							<dt>{ t(ctx, "stats.picture.completion") }</dt>
							<dd>{ data.CompletionRate }</dd>
						</div>
					}
					<div>
						<dt>{ t(ctx, "stats.picture.perday") }</dt>
						<dd>{ data.PerDay }</dd>
						<dd class="stat-sub">{ data.PerDayNote }</dd>
					</div>
					if data.TimeToComplete != "" {
						<div>
							<dt>{ t(ctx, "stats.picture.time") }</dt>
							<dd>{ data.TimeToComplete }</dd>
							<dd class="stat-sub">{ data.TimedNote }</dd>
						</div>
					}
				</dl>
				<p class="muted">
					{ t(ctx, "stats.picture.note") }
				</p>
				if data.LumpNote != "" {
					<p class="muted">{ data.LumpNote }</p>
				}
			</section>
			<section class="card trend js-panel" id="trend">
				<div class="title-row">
					<h2>{ t(ctx, "stats.trend.heading") }</h2>
					<div class="trend-controls js-trend-controls"></div>
				</div>
				<p class="muted">{ t(ctx, "stats.trend.range", uitext.Args{"Range": data.Range.Label}) }</p>
				<div class="trend-chart js-trend-chart" role="img" aria-label={ t(ctx, "stats.trend.aria") }></div>
				<div class="trend-table js-trend-table">
					if len(data.TrendRows) == 0 {
						<p class="muted">{ t(ctx, "stats.trend.empty") }</p>
					} else {
						<div class="table-scroll" tabindex="0">
							<table class="responses">
								<thead>
									<tr>
										<th scope="col">{ t(ctx, "stats.trend.day") }</th>
										<th scope="col">{ t(ctx, "stats.opened.label") }</th>
										<th scope="col">{ t(ctx, "stats.submissions.label") }</th>
									</tr>
								</thead>
								<tbody>
									for _, point := range data.TrendRows {
										<tr>
											<td>{ point.Day }</td>
											<td>{ strconv.Itoa(point.Opened) }</td>
											<td>{ strconv.Itoa(point.Submissions) }</td>
										</tr>
									}
								</tbody>
							</table>
						</div>
					}
				</div>
				@templ.JSONScript("trend-data", data.Trend)
			</section>
			<section class="card js-panel" id="questions">
				<h2>{ t(ctx, "stats.questions.heading") }</h2>
				<p class="muted">
					{ t(ctx, "stats.questions.intro") }
				</p>
				if len(data.Questions) == 0 {
					<p class="muted">{ t(ctx, "stats.questions.empty") }</p>
				} else {
					<div class="table-scroll" tabindex="0">
						<table class="responses stops js-stops" data-sortable>
							<thead>
								<tr>
									<th scope="col" data-sort="text">{ t(ctx, "stats.questions.question") }</th>
									<th scope="col" data-sort="number" class="num">{ t(ctx, "stats.questions.stopped") }</th>
								</tr>
							</thead>
							<tbody>
								for _, row := range data.Questions {
									<tr>
										<td>
											<span class="chip chip-small">{ row.TypeLabel }</span>
											if row.Required {
												<span class="required" title={ t(ctx, "stats.questions.required") }>*</span>
											}
											{ row.Text }
										</td>
										<td class="num" data-value={ strconv.Itoa(row.Stopped) }>
											{ strconv.Itoa(row.Stopped) } <span class="muted">({ row.Share })</span>
										</td>
									</tr>
								}
							</tbody>
						</table>
					</div>
				}
				if data.StopsNote != "" {
					<p class="muted">{ data.StopsNote }</p>
				}
			</section>
			<section class="card stats js-panel js-audience">
				<h2>{ t(ctx, "stats.audience.heading") }</h2>
				<p class="muted">
					{ t(ctx, "stats.audience.intro") }
				</p>
				if data.HasAudience {
					@statBuckets(t(ctx, "stats.audience.browser"), data.Browsers)
					@statBuckets(t(ctx, "stats.audience.device"), data.Devices)
					@statBuckets(t(ctx, "stats.audience.country"), data.Countries)
					<p class="muted">{ data.SuppressionNote }</p>
				} else {
					<p class="muted">{ t(ctx, "stats.audience.empty") } { data.SuppressionNote }</p>
				}
			</section>
		</main>
		@jsText(ctx, "js.stats", "stats.submissions.label", "stats.opened.label")
		<script src={ static.AssetURL("js/uitext.js") } defer></script>
		<script src={ static.AssetURL("js/stats.js") } defer></script>
	}
}

// rangeControl is a GET form, so a range is a URL: bookmarkable, and the
// CSV link downloads exactly what the page shows.
templ rangeControl(data SurveyStatsData) {
	<form method="get" action={ templ.SafeURL("/surveys/" + data.Survey.ID + "/stats") } class="range-form">
		<nav class="range-presets" aria-label={ t(ctx, "stats.range.aria") }>
			@rangePreset(data, "7d", t(ctx, "stats.range.week"))
			@rangePreset(data, "30d", t(ctx, "stats.range.month"))
			@rangePreset(data, "all", t(ctx, "stats.range.all"))
		</nav>
		<label class="field">
			<span>{ t(ctx, "stats.range.from") }</span>
			<input type="date" name="from" value={ data.Range.FromInput } max={ data.Range.MaxInput } required/>
		</label>
		<label class="field">
			<span>{ t(ctx, "stats.range.to") }</span>
			<input type="date" name="to" value={ data.Range.ToInput } max={ data.Range.MaxInput } required/>
		</label>
		<button type="submit" class="secondary">{ t(ctx, "stats.range.apply.label") }</button>
		<a class="button secondary" href={ templ.SafeURL(data.CSVURL) }>{ t(ctx, "stats.range.csv.label") }</a>
	</form>
}

templ rangePreset(data SurveyStatsData, preset string, label string) {
	if data.Range.Preset == preset {
		<a href={ templ.SafeURL("/surveys/" + data.Survey.ID + "/stats?range=" + preset) } aria-current="true">{ label }</a>
	} else {
		<a href={ templ.SafeURL("/surveys/" + data.Survey.ID + "/stats?range=" + preset) }>{ label }</a>
	}
}

templ statBuckets(title string, rows []CountView) {
	if len(rows) > 0 {
		<h3>{ title }</h3>
		<ul class="distribution">
			for _, row := range rows {
				<li>
					<span class="bar-label">{ row.Label }</span>
					<svg class="bar" aria-hidden="true" focusable="false"><rect class="bar-fill js-bar-fill" width={ barWidth(row.Percent) } height="100%"></rect></svg>
					<span class="bar-count">{ strconv.Itoa(row.Count) } ({ row.Share })</span>
				</li>
			}
		</ul>
	}
}
