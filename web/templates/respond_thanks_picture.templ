package templates

import (
	"strconv"

	"github.com/TryEarful/earful/internal/domain"
)

// thanksPicture is the picture above the thanks page's heading, as the
// survey's style chooses it (ADR-0018): the happy owl, one of the three
// drawings, the creator's own picture, or nothing. The owl and the
// drawings are decoration, as the owl always was there: the heading
// beside them says what happened. The creator's picture says what it
// shows in its own alternative text.
templ thanksPicture(thanks domain.StyleThanks) {
	switch  {
		case thanks.Picture == domain.ThanksNone:
		case thanks.Picture == domain.ThanksImage && !thanks.Image.IsZero():
			<span class="thanks-image">
				<img
					class="js-thanks-image"
					src={ styleImageURL(ctx, thanks.Image) }
					alt={ thanks.Alt }
					width={ strconv.Itoa(thanks.Image.Width) }
					height={ strconv.Itoa(thanks.Image.Height) }
					decoding="async"
				/>
			</span>
		case thanks.Drawing():
			@thanksDrawing(thanks.Picture, 96)
		default:
			@owl(OwlHappy, 96)
	}
}

// thanksDrawing draws one of the pictures a thanks page can show in
// place of the owl. Like the owl it is inline, so that every part is
// filled by a class the stylesheet colours; unlike the owl, its colours
// are the theme's (docs/style-guide.md, "Thanks page pictures"), so it
// belongs to whichever theme the survey is drawn in. None of the three
// is an owl: a survey that carries its own mark can thank in a way that
// is not Earful's.
//
// Each is drawn on a 96 unit square, on a soft disc of the theme's
// accent, with the owl's line weight.
templ thanksDrawing(kind string, size int) {
	<svg
		class={ "thanks-drawing", "thanks-drawing-" + kind, "js-thanks-drawing" }
		data-drawing={ kind }
		viewBox="0 0 96 96"
		width={ strconv.Itoa(size) }
		height={ strconv.Itoa(size) }
		aria-hidden="true"
		focusable="false"
	>
		<circle class="drawing-disc" cx="48" cy="48" r="44"></circle>
		switch kind {
			case domain.ThanksCheck:
				// Received: a seal with a tick, and a ring of small marks
				// about it.
				<circle class="drawing-fill" cx="48" cy="48" r="27"></circle>
				<path class="drawing-on-fill" d="M36 48.5L44.5 57L61 39.5"></path>
				<path class="drawing-spark" d="M48 13.5V8.5"></path>
				<path class="drawing-spark" d="M72.4 23.6L75.9 20.1"></path>
				<path class="drawing-spark" d="M82.5 48H87.5"></path>
				<path class="drawing-spark" d="M72.4 72.4L75.9 75.9"></path>
				<path class="drawing-spark" d="M48 82.5V87.5"></path>
				<path class="drawing-spark" d="M23.6 72.4L20.1 75.9"></path>
				<path class="drawing-spark" d="M13.5 48H8.5"></path>
				<path class="drawing-spark" d="M23.6 23.6L20.1 20.1"></path>
			case domain.ThanksEnvelope:
				// Delivered: a sealed letter, with the lines of its going.
				<path class="drawing-line" d="M10 41H19"></path>
				<path class="drawing-line" d="M7 50H19"></path>
				<path class="drawing-line" d="M10 59H19"></path>
				<rect class="drawing-paper" x="25" y="29" width="58" height="40" rx="6"></rect>
				<path class="drawing-stroke" d="M27 33L54 53L81 33"></path>
				<circle class="drawing-fill" cx="54" cy="53" r="8"></circle>
				<path class="drawing-on-fill-thin" d="M50.5 53.2L53 55.6L57.6 50.6"></path>
			case domain.ThanksConfetti:
				// Celebrate: a star, and confetti thrown about it.
				<path class="drawing-star" d="M48 25L53.9 40.9L70.8 41.6L57.5 52.1L62.1 68.4L48 59L33.9 68.4L38.5 52.1L25.2 41.6L42.1 40.9Z"></path>
				<rect class="drawing-piece" x="15" y="21" width="10" height="5.5" rx="2.5" transform="rotate(-30 20 23.75)"></rect>
				<rect class="drawing-piece-soft" x="73" y="23.25" width="10" height="5.5" rx="2.5" transform="rotate(25 78 26)"></rect>
				<rect class="drawing-piece" x="70" y="66" width="10" height="5.5" rx="2.5" transform="rotate(-20 75 68.75)"></rect>
				<rect class="drawing-piece-soft" x="14" y="64" width="10" height="5.5" rx="2.5" transform="rotate(35 19 66.75)"></rect>
				<circle class="drawing-piece-soft" cx="48" cy="14" r="3.5"></circle>
				<circle class="drawing-piece" cx="81" cy="45" r="3.5"></circle>
				<circle class="drawing-piece" cx="15" cy="45" r="3.5"></circle>
				<circle class="drawing-piece-soft" cx="48" cy="82" r="3.5"></circle>
				<path class="drawing-curl" d="M29 80Q32 75 36 78T43 76"></path>
				<path class="drawing-curl" d="M56 12Q59 17 63 14T70 16"></path>
		}
	</svg>
}

// thanksChoicePreview is a choice's picture on the Style tab, drawn
// small, in the colours of the theme the style has saved, so a drawing
// looks as the thanks page will draw it. The creator's own picture is
// shown small where one is stored, and otherwise as a frame waiting for
// it; "none" shows an empty frame.
templ thanksChoicePreview(picture string, style domain.Style) {
	<span class={ "thanks-choice-preview", themeClass(style) } aria-hidden="true">
		switch picture {
			case domain.ThanksOwl:
				@owl(OwlHappy, 48)
			case domain.ThanksCheck, domain.ThanksEnvelope, domain.ThanksConfetti:
				@thanksDrawing(picture, 48)
			case domain.ThanksImage:
				if !style.Thanks.Image.IsZero() {
					<span class="thanks-choice-image style-logo">
						<img
							class="js-thanks-choice-image"
							src={ styleImageURL(ctx, style.Thanks.Image) }
							alt=""
							width={ strconv.Itoa(style.Thanks.Image.Width) }
							height={ strconv.Itoa(style.Thanks.Image.Height) }
							decoding="async"
						/>
					</span>
				} else {
					<svg class="thanks-choice-frame" viewBox="0 0 48 48" width="48" height="48" focusable="false">
						<rect class="frame-edge" x="4" y="8" width="40" height="32" rx="5"></rect>
						<circle class="frame-mark" cx="16" cy="19" r="4"></circle>
						<path class="frame-mark" d="M8 36L19 25L27 32L33 27L40 33V36Z"></path>
					</svg>
				}
			default:
				<svg class="thanks-choice-frame" viewBox="0 0 48 48" width="48" height="48" focusable="false">
					<rect class="frame-edge frame-empty" x="4" y="8" width="40" height="32" rx="5"></rect>
				</svg>
		}
	</span>
}
