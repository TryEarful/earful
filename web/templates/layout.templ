package templates

import "github.com/TryEarful/earful/web/static"

templ Layout(title string) {
	<!DOCTYPE html>
	<html lang={ lang(ctx) }>
		<head>
			<meta charset="utf-8"/>
			<meta name="viewport" content="width=device-width, initial-scale=1"/>
			<title>{ title }</title>
			<link rel="stylesheet" href={ static.AssetURL("css/app.css") }/>
		</head>
		<body>
			{ children... }
		</body>
	</html>
}
