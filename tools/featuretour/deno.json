{
    "tasks": {
        "run": "deno run -A src/main.ts",
        "deck": "deno run -A src/main.ts --only deck",
        "check": "deno check src/main.ts && deno fmt --check && deno lint"
    },
    "imports": {
        "playwright": "npm:playwright@1.61.1",
        "@std/cli": "jsr:@std/cli@^1",
        "@std/encoding": "jsr:@std/encoding@^1",
        "@std/path": "jsr:@std/path@^1",
        "@std/yaml": "jsr:@std/yaml@^1"
    },
    "nodeModulesDir": "auto",
    "compilerOptions": {
        "lib": [
            "deno.window",
            "dom",
            "dom.iterable"
        ]
    },
    "fmt": {
        "lineWidth": 100,
        "proseWrap": "preserve",
        "exclude": [
            "content/"
        ]
    },
    "lint": {
        "rules": {
            "exclude": [
                "no-explicit-any"
            ]
        }
    }
}
